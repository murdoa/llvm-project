; RUN: opt -mtriple=m6809 -passes=loop-unroll-full -S < %s | FileCheck %s

; At optsize a loop is fully unrolled when the copies, simplified for their
; iterations, are estimated to be no bigger than the loop. Two steps of a
; state machine: the first copy knows the starting state.
define i8 @two_steps(ptr %events) minsize optsize {
; CHECK-LABEL: define i8 @two_steps(
; CHECK-SAME: ptr [[EVENTS:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[E:%.*]] = load volatile i8, ptr [[EVENTS]], align 1
; CHECK-NEXT:    switch i8 0, label %[[LATCH:.*]] [
; CHECK-NEXT:      i8 0, label %[[IDLE:.*]]
; CHECK-NEXT:      i8 1, label %[[BUSY:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[IDLE]]:
; CHECK-NEXT:    [[START:%.*]] = icmp eq i8 [[E]], 0
; CHECK-NEXT:    [[S_IDLE:%.*]] = select i1 [[START]], i8 1, i8 0
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[BUSY]]:
; CHECK-NEXT:    [[TICK:%.*]] = icmp eq i8 [[E]], 1
; CHECK-NEXT:    [[S_BUSY:%.*]] = select i1 [[TICK]], i8 2, i8 1
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[S_NEXT:%.*]] = phi i8 [ 0, %[[LOOP]] ], [ [[S_IDLE]], %[[IDLE]] ], [ [[S_BUSY]], %[[BUSY]] ]
; CHECK-NEXT:    [[P_1:%.*]] = getelementptr inbounds i8, ptr [[EVENTS]], i16 1
; CHECK-NEXT:    [[E_1:%.*]] = load volatile i8, ptr [[P_1]], align 1
; CHECK-NEXT:    switch i8 [[S_NEXT]], label %[[LATCH_1:.*]] [
; CHECK-NEXT:      i8 0, label %[[IDLE_1:.*]]
; CHECK-NEXT:      i8 1, label %[[BUSY_1:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[BUSY_1]]:
; CHECK-NEXT:    [[TICK_1:%.*]] = icmp eq i8 [[E_1]], 1
; CHECK-NEXT:    [[S_BUSY_1:%.*]] = select i1 [[TICK_1]], i8 2, i8 1
; CHECK-NEXT:    br label %[[LATCH_1]]
; CHECK:       [[IDLE_1]]:
; CHECK-NEXT:    [[START_1:%.*]] = icmp eq i8 [[E_1]], 0
; CHECK-NEXT:    [[S_IDLE_1:%.*]] = select i1 [[START_1]], i8 1, i8 0
; CHECK-NEXT:    br label %[[LATCH_1]]
; CHECK:       [[LATCH_1]]:
; CHECK-NEXT:    [[S_NEXT_1:%.*]] = phi i8 [ [[S_NEXT]], %[[LATCH]] ], [ [[S_IDLE_1]], %[[IDLE_1]] ], [ [[S_BUSY_1]], %[[BUSY_1]] ]
; CHECK-NEXT:    ret i8 [[S_NEXT_1]]
;
entry:
  br label %loop

loop:
  %i = phi i16 [ 0, %entry ], [ %i.next, %latch ]
  %s = phi i8 [ 0, %entry ], [ %s.next, %latch ]
  %p = getelementptr inbounds i8, ptr %events, i16 %i
  %e = load volatile i8, ptr %p
  switch i8 %s, label %latch [
  i8 0, label %idle
  i8 1, label %busy
  ]

idle:
  %start = icmp eq i8 %e, 0
  %s.idle = select i1 %start, i8 1, i8 0
  br label %latch

busy:
  %tick = icmp eq i8 %e, 1
  %s.busy = select i1 %tick, i8 2, i8 1
  br label %latch

latch:
  %s.next = phi i8 [ %s, %loop ], [ %s.idle, %idle ], [ %s.busy, %busy ]
  %i.next = add nuw nsw i16 %i, 1
  %done = icmp eq i16 %i.next, 2
  br i1 %done, label %exit, label %loop

exit:
  ret i8 %s.next
}

; Copies that nothing simplifies stay a loop.
define i8 @sum4(ptr %p) minsize optsize {
; CHECK-LABEL: define i8 @sum4(
