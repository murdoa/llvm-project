; CHECK-NEXT:    [[SUM:%.*]] = phi i8 [ 0, %[[ENTRY]] ], [ [[SUM_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[Q:%.*]] = getelementptr inbounds i8, ptr [[P]], i16 [[I]]
; CHECK-NEXT:    [[V:%.*]] = load volatile i8, ptr [[Q]], align 1
; CHECK-NEXT:    [[X:%.*]] = xor i8 [[V]], [[SUM]]
; CHECK-NEXT:    [[R:%.*]] = shl i8 [[X]], 1
; CHECK-NEXT:    [[SUM_NEXT]] = add i8 [[R]], [[V]]
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i16 [[I]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i16 [[I_NEXT]], 4
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[SUM_NEXT_LCSSA:%.*]] = phi i8 [ [[SUM_NEXT]], %[[LOOP]] ]
; CHECK-NEXT:    ret i8 [[SUM_NEXT_LCSSA]]
;
entry:
  br label %loop

loop:
  %i = phi i16 [ 0, %entry ], [ %i.next, %loop ]
  %sum = phi i8 [ 0, %entry ], [ %sum.next, %loop ]
  %q = getelementptr inbounds i8, ptr %p, i16 %i
  %v = load volatile i8, ptr %q
  %x = xor i8 %v, %sum
  %r = shl i8 %x, 1
  %sum.next = add i8 %r, %v
