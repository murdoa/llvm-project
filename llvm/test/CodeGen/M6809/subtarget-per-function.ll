; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s
; RUN: llc -mtriple=m6809 -mcpu=6309 -verify-machineinstrs < %s | FileCheck %s

; Each function is compiled for its own "target-cpu", whatever -mcpu says,
; so 6809 and HD6309 code can be mixed (in LTO, for example). Only @hd6309
; may use LSRD.

define i16 @hd6309(i16 %x) "target-cpu"="6309" {
; CHECK-LABEL: hd6309:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    lsrd
; CHECK-NEXT:    rts
  %r = lshr i16 %x, 1
  ret i16 %r
}

define i16 @m6809(i16 %x) "target-cpu"="6809" {
; CHECK-LABEL: m6809:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    lsra
; CHECK-NEXT:    rorb
; CHECK-NEXT:    rts
  %r = lshr i16 %x, 1
  ret i16 %r
}
