}

; ULE against a constant becomes ULT against the constant plus one:
; 70001 = 0x00011171.
define void @br_ule_imm(i32 %a) {
; CHECK-LABEL: br_ule_imm:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd 2,s
; CHECK-NEXT:    subd #4465
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    sbcb #1
; CHECK-NEXT:    sbca #0
; CHECK-NEXT:    bhs .LBB2_2
; CHECK-NEXT:  ; %bb.1: ; %t
; CHECK-NEXT:    jsr f
; CHECK-NEXT:  .LBB2_2: ; %e
; CHECK-NEXT:    rts
  %c = icmp ule i32 %a, 70000
  br i1 %c, label %t, label %e
t:
  call void @f()
  br label %e
e:
  ret void
}

; 5 < a is a > 5, which is a >= 6.
define void @br_const_lhs(i32 %a) {
; CHECK-LABEL: br_const_lhs:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd 2,s
; CHECK-NEXT:    subd #6
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    sbcb #0
; CHECK-NEXT:    sbca #0
; CHECK-NEXT:    blt .LBB3_2
; CHECK-NEXT:  ; %bb.1: ; %t
; CHECK-NEXT:    jsr f
; CHECK-NEXT:  .LBB3_2: ; %e
; CHECK-NEXT:    rts
  %c = icmp slt i32 5, %a
  br i1 %c, label %t, label %e
t:
  call void @f()
  br label %e
e:
  ret void
}

; The right-hand side loaded through a pointer: subd 2,x, then the high
; half from ,x.
define void @br_mem(i32 %a, ptr %p) {
; M6809-LABEL: br_mem:
; M6809:       ; %bb.0:
; M6809-NEXT:    tfr d, x
; M6809-NEXT:    ldd 2,s
; M6809-NEXT:    ldy 4,s
; M6809-NEXT:    subd 2,y
; M6809-NEXT:    tfr x, d
; M6809-NEXT:    sbcb 1,y
; M6809-NEXT:    sbca ,y
; M6809-NEXT:    bhs .LBB4_2
; M6809-NEXT:  ; %bb.1: ; %t
; M6809-NEXT:    jsr f
; M6809-NEXT:  .LBB4_2: ; %e
; M6809-NEXT:    rts
;
; H6309-LABEL: br_mem:
; H6309:       ; %bb.0:
; H6309-NEXT:    tfr d, x
; H6309-NEXT:    ldd 2,s
; H6309-NEXT:    ldy 4,s
; H6309-NEXT:    subd 2,y
; H6309-NEXT:    tfr x, d
; H6309-NEXT:    sbcd ,y
; H6309-NEXT:    bhs .LBB4_2
; H6309-NEXT:  ; %bb.1: ; %t
; H6309-NEXT:    jsr f
; H6309-NEXT:  .LBB4_2: ; %e
; H6309-NEXT:    rts
  %b = load i32, ptr %p
  %c = icmp ult i32 %a, %b
  br i1 %c, label %t, label %e
t:
  call void @f()
  br label %e
e:
  ret void
}

; SELECT32 with an immediate whose low half is not zero.
define i32 @sel_imm(i32 %a, i32 %x, i32 %y) {
; CHECK-LABEL: sel_imm:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd 2,s
; CHECK-NEXT:    subd #-31072
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    sbcb #1
; CHECK-NEXT:    sbca #0
; CHECK-NEXT:    blt .LBB5_1
; CHECK-NEXT:  ; %bb.2:
; CHECK-NEXT:    ldd 8,s
; CHECK-NEXT:    ldx 10,s
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB5_1:
; CHECK-NEXT:    ldd 4,s
; CHECK-NEXT:    ldx 6,s
; CHECK-NEXT:    rts
  %c = icmp slt i32 %a, 100000
  %r = select i1 %c, i32 %x, i32 %y
  ret i32 %r
}

; With a zero low half (131072 = 0x00020000) only the high halves are
; compared.
define i32 @sel_zero_low(i32 %a, i32 %x, i32 %y) {
; CHECK-LABEL: sel_zero_low:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    cmpd #2
; CHECK-NEXT:    blo .LBB6_1
; CHECK-NEXT:  ; %bb.2:
; CHECK-NEXT:    ldd 8,s
; CHECK-NEXT:    ldx 10,s
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB6_1:
; CHECK-NEXT:    ldd 4,s
; CHECK-NEXT:    ldx 6,s
; CHECK-NEXT:    rts
  %c = icmp ult i32 %a, 131072
  %r = select i1 %c, i32 %x, i32 %y
  ret i32 %r
}

