; i32 compares not covered by cmp32.ll. Ordered compares in a branch or a
; select are a subtraction through the carry (sbcb/sbca, or sbcd on the
; HD6309); equality is left to the generic expansion, which ORs the XORed
; halves; a compare used as a value is also expanded generically.

declare void @f()

define void @br_eq(i32 %a, i32 %b) {
; M6809-LABEL: br_eq:
; M6809:       ; %bb.0:
; M6809-NEXT:    eora 4,s
; M6809-NEXT:    eorb 5,s
; M6809-NEXT:    tfr d, x
; M6809-NEXT:    ldd 2,s
; M6809-NEXT:    eora 6,s
; M6809-NEXT:    eorb 7,s
; M6809-NEXT:    pshs x
; M6809-NEXT:    ora ,s+
; M6809-NEXT:    orb ,s+
; M6809-NEXT:    subd #0
; M6809-NEXT:    bne .LBB0_2
; M6809-NEXT:  ; %bb.1: ; %t
; M6809-NEXT:    jsr f
; M6809-NEXT:  .LBB0_2: ; %e
; M6809-NEXT:    rts
;
; H6309-LABEL: br_eq:
; H6309:       ; %bb.0:
; H6309-NEXT:    eord 4,s
; H6309-NEXT:    tfr d, x
; H6309-NEXT:    ldd 2,s
; H6309-NEXT:    eord 6,s
; H6309-NEXT:    orr x, d
; H6309-NEXT:    tstd
; H6309-NEXT:    bne .LBB0_2
; H6309-NEXT:  ; %bb.1: ; %t
; H6309-NEXT:    jsr f
; H6309-NEXT:  .LBB0_2: ; %e
; H6309-NEXT:    rts
  %c = icmp eq i32 %a, %b
  br i1 %c, label %t, label %e
t:
  call void @f()
  br label %e
e:
  ret void
}

; 100000 = 0x000186a0: the high half is 1 and the low half -31072.
define void @br_ne_imm(i32 %a) {
; M6809-LABEL: br_ne_imm:
; M6809:       ; %bb.0:
; M6809-NEXT:    eorb #1
; M6809-NEXT:    tfr d, x
; M6809-NEXT:    ldd #-31072
; M6809-NEXT:    eora 2,s
; M6809-NEXT:    eorb 3,s
; M6809-NEXT:    pshs x
; M6809-NEXT:    ora ,s+
; M6809-NEXT:    orb ,s+
; M6809-NEXT:    subd #0
; M6809-NEXT:    beq .LBB1_2
; M6809-NEXT:  ; %bb.1: ; %t
; M6809-NEXT:    jsr f
; M6809-NEXT:  .LBB1_2: ; %e
; M6809-NEXT:    rts
;
; H6309-LABEL: br_ne_imm:
; H6309:       ; %bb.0:
; H6309-NEXT:    eorb #1
; H6309-NEXT:    tfr d, x
; H6309-NEXT:    ldd #-31072
; H6309-NEXT:    eord 2,s
; H6309-NEXT:    orr x, d
; H6309-NEXT:    tstd
; H6309-NEXT:    beq .LBB1_2
; H6309-NEXT:  ; %bb.1: ; %t
; H6309-NEXT:    jsr f
; H6309-NEXT:  .LBB1_2: ; %e
; H6309-NEXT:    rts
  %c = icmp ne i32 %a, 100000
  br i1 %c, label %t, label %e
t:
