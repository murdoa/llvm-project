; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s --check-prefix=M6809
; RUN: llc -mtriple=m6809 -mcpu=6309 -verify-machineinstrs < %s \
; RUN:   | FileCheck %s --check-prefix=HD6309

; An interrupt handler returns with RTI. For IRQ, NMI and SWI the CPU saves
; every register, so the handler saves none of its own, not even U, except
; W on the HD6309, which the CPU leaves alone in emulation mode. A handler
; makes no sibling calls: the callee would return with RTS.

@count = global i16 0
declare void @work(i16)

define void @tick() "interrupt" {
; M6809-LABEL: tick:
; M6809:       ; %bb.0:
; M6809-NEXT:    ldd #1
; M6809-NEXT:    addd count
; M6809-NEXT:    std count
; M6809-NEXT:    rti
;
; HD6309-LABEL: tick:
; HD6309:       ; %bb.0:
; HD6309-NEXT:    ldd #1
; HD6309-NEXT:    addd count
; HD6309-NEXT:    std count
; HD6309-NEXT:    rti
  %c = load volatile i16, ptr @count
  %n = add i16 %c, 1
  store volatile i16 %n, ptr @count
  ret void
}

define void @calls() "interrupt" {
; M6809-LABEL: calls:
; M6809:       ; %bb.0:
; M6809-NEXT:    ldd count
; M6809-NEXT:    jsr work
; M6809-NEXT:    rti
;
; HD6309-LABEL: calls:
; HD6309:       ; %bb.0:
; HD6309-NEXT:    leas -2,s
; HD6309-NEXT:    stw ,s ; 2-byte Folded Spill
; HD6309-NEXT:    ldd count
; HD6309-NEXT:    jsr work
; HD6309-NEXT:    ldw ,s ; 2-byte Folded Reload
; HD6309-NEXT:    leas 2,s
; HD6309-NEXT:    rti
  %c = load volatile i16, ptr @count
  call void @work(i16 %c)
  ret void
}

define void @tail() "interrupt" {
; M6809-LABEL: tail:
; M6809:       ; %bb.0:
; M6809-NEXT:    ldd #1
; M6809-NEXT:    jsr work
; M6809-NEXT:    rti
;
; HD6309-LABEL: tail:
; HD6309:       ; %bb.0:
; HD6309-NEXT:    leas -2,s
; HD6309-NEXT:    stw ,s ; 2-byte Folded Spill
; HD6309-NEXT:    ldd #1
; HD6309-NEXT:    jsr work
; HD6309-NEXT:    ldw ,s ; 2-byte Folded Reload
; HD6309-NEXT:    leas 2,s
; HD6309-NEXT:    rti
  tail call void @work(i16 1)
  ret void
}

; Every register is free to use, U included.
define void @busy(ptr %p) "interrupt" {
; M6809-LABEL: busy:
; M6809:       ; %bb.0:
; M6809-NEXT:    ldy count
; M6809-NEXT:    ldx count
; M6809-NEXT:    ldu count
; M6809-NEXT:    ldd count
; M6809-NEXT:    std count
; M6809-NEXT:    stu count
; M6809-NEXT:    stx count
; M6809-NEXT:    sty count
; M6809-NEXT:    rti
;
; HD6309-LABEL: busy:
; HD6309:       ; %bb.0:
; HD6309-NEXT:    ldy count
; HD6309-NEXT:    ldx count
; HD6309-NEXT:    ldu count
; HD6309-NEXT:    ldd count
; HD6309-NEXT:    std count
; HD6309-NEXT:    stu count
; HD6309-NEXT:    stx count
; HD6309-NEXT:    sty count
; HD6309-NEXT:    rti
  %a = load volatile i16, ptr @count
  %b = load volatile i16, ptr @count
  %c = load volatile i16, ptr @count
  %d = load volatile i16, ptr @count
  store volatile i16 %d, ptr @count
  store volatile i16 %c, ptr @count
  store volatile i16 %b, ptr @count
  store volatile i16 %a, ptr @count
  ret void
}
