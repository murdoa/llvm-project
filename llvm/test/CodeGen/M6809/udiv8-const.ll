; i8 divide and remainder by a constant use MUL's high byte, also when
; optimising for size: the runtime library's i16 divide is larger to call.
; A divisor that is not constant still calls the library.

define i8 @udiv10(i8 %a) minsize {
; CHECK-LABEL: udiv10:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr b, a
; CHECK-NEXT:    ldb #-51
; CHECK-NEXT:    mul
; CHECK-NEXT:    tfr a, b
; CHECK-NEXT:    lsrb
; CHECK-NEXT:    lsrb
; CHECK-NEXT:    lsrb
; CHECK-NEXT:    rts
  %r = udiv i8 %a, 10
  ret i8 %r
}

