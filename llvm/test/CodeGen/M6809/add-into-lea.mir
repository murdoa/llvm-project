# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=m6809 -run-pass=m6809-post-ra-cleanup -verify-machineinstrs %s -o - | FileCheck %s

# An addition into D whose sum is only moved to an index register becomes
# one LEA: "pshs x; addd ,s++; tfr d,x" is "leax d,x". If D is still live,
# the sum is moved back into it. Not when the flags of the ADDD are read.

---
name: d_dead
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d, $u
    ; CHECK-LABEL: name: d_dead
    ; CHECK: liveins: $d, $u
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x = LEA16dr killed $u, killed $d, implicit-def $cc
    ; CHECK-NEXT: $b = LD8m killed $x, 0, 0, implicit-def $cc
    ; CHECK-NEXT: RTS implicit killed $b
    PSHS16 $u, implicit-def $s, implicit $s
    $d = ADDDpop $d, implicit-def $s, implicit-def $cc, implicit $s
    $x = TFR16 $d
    $b = LD8m $x, 0, 0, implicit-def $cc
    RTS implicit $b
...
---
name: d_live
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d, $x
    ; CHECK-LABEL: name: d_live
    ; CHECK: liveins: $d, $x
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $y = LEA16dr killed $x, killed $d, implicit-def $cc
    ; CHECK-NEXT: $d = TFR16 $y
    ; CHECK-NEXT: $b = LD8m killed $y, 0, 0, implicit-def $cc
    ; CHECK-NEXT: RTS implicit killed $b, implicit killed $d
    PSHS16 $x, implicit-def $s, implicit $s
    $d = ADDDpop $d, implicit-def $s, implicit-def $cc, implicit $s
    $y = TFR16 $d
    $b = LD8m $y, 0, 0, implicit-def $cc
    RTS implicit $b, implicit $d
...
---
name: flags_read
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: flags_read
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $d, $x
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PSHS16 $x, implicit-def $s, implicit $s
  ; CHECK-NEXT:   $d = ADDDpop $d, implicit-def $s, implicit-def $cc, implicit $s
  ; CHECK-NEXT:   $x = TFR16 $d
  ; CHECK-NEXT:   LBcc 5, %bb.2, implicit $cc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $x
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RTS implicit $x
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RTS
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $d, $x
    PSHS16 $x, implicit-def $s, implicit $s
    $d = ADDDpop $d, implicit-def $s, implicit-def $cc, implicit $s
    $x = TFR16 $d
    LBcc 5, %bb.2, implicit $cc
  bb.1:
    liveins: $x
    RTS implicit $x
  bb.2:
    RTS
...
