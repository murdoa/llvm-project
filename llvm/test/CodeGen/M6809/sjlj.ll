; RUN: llc -mtriple=m6809 < %s | FileCheck %s

; __builtin_setjmp and __builtin_longjmp. Words 1 and 3 of the buffer hold
; the resume address and U; clang stores the frame address and S in words 0
; and 2.

@buf = global [5 x ptr] zeroinitializer

define i16 @setjmp() {
; CHECK-LABEL: setjmp:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    stu ,s ; 2-byte Folded Spill
; CHECK-NEXT:    ldx #buf
; CHECK-NEXT:    ldd #.LBB0_3
; CHECK-NEXT:    std 2,x
; CHECK-NEXT:    stu 6,x
; CHECK-NEXT:  ; %bb.1:
; CHECK-NEXT:    ldd #0
; CHECK-NEXT:    lbra .LBB0_2
; CHECK-NEXT:  .LBB0_3: ; Block address taken
; CHECK-NEXT:    ldd #1
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    ldu ,s ; 2-byte Folded Reload
; CHECK-NEXT:    leas 2,s
; CHECK-NEXT:    rts
  %r = call i32 @llvm.eh.sjlj.setjmp(ptr @buf)
  %t = trunc i32 %r to i16
  ret i16 %t
}

define void @longjmp() {
; CHECK-LABEL: longjmp:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    stu ,s ; 2-byte Folded Spill
; CHECK-NEXT:    ldx #buf
; CHECK-NEXT:    ldu 6,x
; CHECK-NEXT:    lds 4,x
; CHECK-NEXT:    jmp [2,x]
  call void @llvm.eh.sjlj.longjmp(ptr @buf)
  unreachable
}
