; Variables in a .dp or .dp.* section are in the page DP points at: they
; are read and written with a one-byte direct address, "<var". The rest
; keep the two-byte extended address, and taking an address is unchanged.

; OBJ-LABEL: <set_flag>:
; OBJ-NEXT: d7 00 stb <0
; OBJ-NEXT: R_M6809_DP8 flag
; OBJ-LABEL: <clear_both>:
; OBJ-NEXT: 7f 00 00 clr >0
; OBJ-NEXT: R_M6809_16 far
; OBJ-NEXT: 0f 00 clr <0
; OBJ-NEXT: R_M6809_DP8 flag

@flag = global i8 0, section ".dp.bss"
@word = global i16 0, section ".dp"
@pair = global [2 x i16] zeroinitializer, section ".dp.bss"
@far = global i8 0
@alias = alias i16, ptr @word

define void @set_flag(i8 %v) {
; CHECK-LABEL: set_flag:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    stb <flag
; CHECK-NEXT:    rts
  store i8 %v, ptr @flag
  ret void
}

define i16 @get_word() {
; CHECK-LABEL: get_word:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldd <word
; CHECK-NEXT:    rts
  %v = load i16, ptr @word
  ret i16 %v
}

define i16 @get_second() {
; CHECK-LABEL: get_second:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldd <pair+2
; CHECK-NEXT:    rts
