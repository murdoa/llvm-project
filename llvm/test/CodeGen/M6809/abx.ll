; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; A 16-bit value plus a zero-extended byte is ABX when they can be in X
; and B: 1 byte and 3 cycles, where "clra; leax d,x" is 3 bytes and 10.

define i16 @sum(ptr %p, i16 %n) {
; CHECK-LABEL: sum:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    pshs u
; CHECK-NEXT:    tfr d, u
; CHECK-NEXT:    ldy 4,s
; CHECK-NEXT:    beq .LBB0_1
; CHECK-NEXT:  ; %bb.2: ; %loop.preheader
; CHECK-NEXT:    ldx #0
; CHECK-NEXT:  .LBB0_3: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldb ,u+
; CHECK-NEXT:    abx
; CHECK-NEXT:    leay -1,y
; CHECK-NEXT:    bne .LBB0_3
; CHECK-NEXT:  ; %bb.4: ; %exit
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    puls u,pc
; CHECK-NEXT:  .LBB0_1:
; CHECK-NEXT:    ldx #0
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    puls u,pc
entry:
  %z = icmp eq i16 %n, 0
  br i1 %z, label %exit, label %loop

loop:
  %c = phi i16 [ %c1, %loop ], [ %n, %entry ]
  %q = phi ptr [ %q1, %loop ], [ %p, %entry ]
  %s = phi i16 [ %s1, %loop ], [ 0, %entry ]
  %v = load i8, ptr %q
  %q1 = getelementptr inbounds i8, ptr %q, i16 1
  %w = zext i8 %v to i16
  %s1 = add i16 %s, %w
  %c1 = add i16 %c, -1
  %done = icmp eq i16 %c1, 0
  br i1 %done, label %exit, label %loop

exit:
  %r = phi i16 [ 0, %entry ], [ %s1, %loop ]
  ret i16 %r
}
