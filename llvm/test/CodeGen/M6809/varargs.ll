; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; Variadic functions. va_list is a plain pointer to the next argument in
; the caller's packed argument area, and variadic arguments always go on
; the stack, even the first one and even i8 ones.

declare i16 @vf(i16, ...)

; va_arg of an i16 then an i8: they sit at 2,s and 4,s on entry (4,s and
; 6,s after the two-byte va_list slot), and the final pointer is 3 bytes
; past the start.
define i16 @two_args(i16 %n, ...) {
; CHECK-LABEL: two_args:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    leax 6,s
; CHECK-NEXT:    ldb ,x+
; CHECK-NEXT:    stx ,s
; CHECK-NEXT:    ; kill: def $b killed $b def $d
; CHECK-NEXT:    sex
; CHECK-NEXT:    addd 4,s
; CHECK-NEXT:    leas 2,s
; CHECK-NEXT:    rts
  %ap = alloca ptr
  call void @llvm.va_start.p0(ptr %ap)
  %a = va_arg ptr %ap, i16
  %b = va_arg ptr %ap, i8
  %e = sext i8 %b to i16
  %r = add i16 %a, %e
  call void @llvm.va_end.p0(ptr %ap)
  ret i16 %r
}

; With no fixed arguments the variadic ones start right above the return
; address.
define i16 @no_fixed(...) {
; CHECK-LABEL: no_fixed:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    leax 6,s
; CHECK-NEXT:    stx ,s
; CHECK-NEXT:    ldd 4,s
; CHECK-NEXT:    leas 2,s
; CHECK-NEXT:    rts
  %ap = alloca ptr
  call void @llvm.va_start.p0(ptr %ap)
  %a = va_arg ptr %ap, i16
  call void @llvm.va_end.p0(ptr %ap)
  ret i16 %a
}

; va_copy copies the pointer.
define void @copy(ptr %d, ptr %s) {
; CHECK-LABEL: copy:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, y
; CHECK-NEXT:    ldx 2,s
; CHECK-NEXT:    ldd ,x
; CHECK-NEXT:    std ,y
; CHECK-NEXT:    rts
  call void @llvm.va_copy.p0(ptr %d, ptr %s)
  ret void
}

; The fixed i16 goes in D; the variadic i8 takes one byte at ,s and the
; i32 (70000 = 0x00011170) follows at 1,s, high word first.
define i16 @call_mixed(i8 %c) {
; CHECK-LABEL: call_mixed:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -5,s
; CHECK-NEXT:    ldx #4464
; CHECK-NEXT:    stx 3,s
; CHECK-NEXT:    ldx #1
; CHECK-NEXT:    stx 1,s
; CHECK-NEXT:    stb ,s
; CHECK-NEXT:    ldd #1
; CHECK-NEXT:    jsr vf
; CHECK-NEXT:    leas 5,s
; CHECK-NEXT:    rts
  %r = call i16 (i16, ...) @vf(i16 1, i8 %c, i32 70000)
  ret i16 %r
}
