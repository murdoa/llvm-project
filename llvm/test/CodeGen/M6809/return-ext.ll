; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; A zeroext or signext byte result comes back in B and is extended no
; further: callers never read A for it, and extend it themselves.

define zeroext i8 @ret_zext(i8 %a) {
; CHECK-LABEL: ret_zext:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    lsrb
; CHECK-NEXT:    rts
  %r = lshr i8 %a, 1
  ret i8 %r
}

define signext i8 @ret_sext(i8 %a) {
; CHECK-LABEL: ret_sext:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addb #3
; CHECK-NEXT:    rts
  %r = add i8 %a, 3
  ret i8 %r
}

define zeroext i1 @ret_bool(i16 %a) {
; CHECK-LABEL: ret_bool:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldb #1
; CHECK-NEXT:    cmpx #5
; CHECK-NEXT:    beq .LBB2_2
; CHECK-NEXT:  ; %bb.1:
; CHECK-NEXT:    clrb
; CHECK-NEXT:  .LBB2_2:
; CHECK-NEXT:    rts
  %r = icmp eq i16 %a, 5
  ret i1 %r
}

declare zeroext i8 @get()

define i16 @caller_widens() {
; CHECK-LABEL: caller_widens:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    jsr get
; CHECK-NEXT:    ; kill: def $b killed $b def $d
; CHECK-NEXT:    clra
; CHECK-NEXT:    rts
  %v = call zeroext i8 @get()
  %w = zext i8 %v to i16
  ret i16 %w
}
