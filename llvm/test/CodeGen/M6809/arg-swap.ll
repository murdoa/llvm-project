; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; n arrives in A but ABX wants it in B, which still holds f. MachineCSE
; narrows the copy of A to B's class; M6809SplitDOperands undoes that, so
; f is read in B and n moves to B only at the ABX, instead of allocation
; failing.
define fastcc ptr @arg_swap(i8 %f, i8 %n, ptr %p) {
; CHECK-LABEL: arg_swap:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    ldy #0
; CHECK-NEXT:    tstb
; CHECK-NEXT:    beq .LBB0_2
; CHECK-NEXT:  ; %bb.1: ; %entry
; CHECK-NEXT:    tfr a, b
; CHECK-NEXT:    abx
; CHECK-NEXT:    tfr x, y
; CHECK-NEXT:  .LBB0_2: ; %entry
; CHECK-NEXT:    tfr y, x
; CHECK-NEXT:    rts
entry:
  %cmp = icmp eq i8 %f, 0
  %conv = zext i8 %n to i16
  %q = getelementptr i8, ptr %p, i16 %conv
  %r = select i1 %cmp, ptr null, ptr %q
  ret ptr %r
}
