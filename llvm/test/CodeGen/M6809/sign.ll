; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; An arithmetic shift right by the width less one gives the sign in every
; bit. A byte: "asl; ld #0; sbc #0" (LD leaves C alone). A word: the sign
; extension of the high byte, copied to the low byte.

define i8 @sign8(i8 %x) {
; CHECK-LABEL: sign8:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    aslb
; CHECK-NEXT:    ldb #0
; CHECK-NEXT:    sbcb #0
; CHECK-NEXT:    rts
  %r = ashr i8 %x, 7
  ret i8 %r
}

define i16 @sign16(i16 %x) {
; CHECK-LABEL: sign16:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr a, b
; CHECK-NEXT:    sex
; CHECK-NEXT:    tfr a, b
; CHECK-NEXT:    rts
  %r = ashr i16 %x, 15
  ret i16 %r
}

; The low half of the result is the value itself, which moves to X.
define i32 @int_to_long(i16 %x) {
; CHECK-LABEL: int_to_long:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    tfr a, b
; CHECK-NEXT:    sex
; CHECK-NEXT:    tfr a, b
; CHECK-NEXT:    rts
  %r = sext i16 %x to i32
  ret i32 %r
}
