; The usual C idiom becomes a rotate loop.
define i16 @rotl_var(i16 %v, i8 %n) {
; CHECK-LABEL: rotl_var:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, y
; CHECK-NEXT:    ldb 2,s
; CHECK-NEXT:    ; kill: def $b killed $b def $d
; CHECK-NEXT:    clra
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    tfr y, d
; CHECK-NEXT:    leax ,x
; CHECK-NEXT:    beq .LBB7_2
; CHECK-NEXT:  .LBB7_1: ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    aslb
; CHECK-NEXT:    rola
; CHECK-NEXT:    adcb #0
; CHECK-NEXT:    leax -1,x
; CHECK-NEXT:    bne .LBB7_1
; CHECK-NEXT:  .LBB7_2:
; CHECK-NEXT:    rts
  %c = zext i8 %n to i16
  %shl = shl i16 %v, %c
  %sub = sub nsw i16 16, %c
  %shr = lshr i16 %v, %sub
  %or = or disjoint i16 %shr, %shl
  ret i16 %or
}

