; The 6809 only rotates through carry. A one-bit rotate of D is
; "aslb; rola; adcb #0" left and "pshs b; lsr ,s+; rora; rorb" right; a
; rotate by 8 is "exg a,b". Constant amounts take the cheapest mix.

define i16 @rotl1(i16 %v) {
; CHECK-LABEL: rotl1:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    aslb
; CHECK-NEXT:    rola
; CHECK-NEXT:    adcb #0
; CHECK-NEXT:    rts
  %r = call i16 @llvm.fshl.i16(i16 %v, i16 %v, i16 1)
  ret i16 %r
}

