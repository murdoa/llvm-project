; Multiply and divide on both CPUs. The 6809 calls the runtime library for
; i16 multiply, divide and remainder; the HD6309 uses muld and divq, with
; the operand from memory, from an immediate, or pushed and read back with
; ,s++. i8 divides are widened to i16 first. i32 always calls the library.

@g16 = global i16 0

define i16 @sdiv_global(i16 %a) {
; M6809-LABEL: sdiv_global:
; M6809:       ; %bb.0:
; M6809-NEXT:    leas -2,s
; M6809-NEXT:    ldx g16
; M6809-NEXT:    stx ,s
; M6809-NEXT:    jsr __divhi3
; M6809-NEXT:    leas 2,s
; M6809-NEXT:    rts
;
; H6309-LABEL: sdiv_global:
; H6309:       ; %bb.0:
; H6309-NEXT:    tfr d, w
; H6309-NEXT:    sexw
; H6309-NEXT:    divq g16
; H6309-NEXT:    tfr w, d
; H6309-NEXT:    rts
  %v = load i16, ptr @g16
  %r = sdiv i16 %a, %v
  ret i16 %r
}

