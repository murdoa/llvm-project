# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=m6809 -run-pass=m6809-post-ra-cleanup -verify-machineinstrs %s -o - | FileCheck %s

# Two moves that undo each other keep the first: "tfr d,u; tfr u,d" is
# "tfr d,u". Two constant steps of one index register are one: "leau 13,s;
# leau 4,u" is "leau 17,s". Not when the second steps another register,
# nor for an auto-increment, nor past 16 bits.

---
name: tfr_back
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d
    ; CHECK-LABEL: name: tfr_back
    ; CHECK: liveins: $d
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $u = TFR16 $d
    ; CHECK-NEXT: RTS implicit killed $d, implicit killed $u
    $u = TFR16 $d
    $d = TFR16 $u
    RTS implicit $d, implicit $u
...
---
name: tfr_back8
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $b
    ; CHECK-LABEL: name: tfr_back8
    ; CHECK: liveins: $b
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $a = TFR8 $b
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $b
    $a = TFR8 $b
    $b = TFR8 $a
    RTS implicit $a, implicit $b
...
---
name: lea_chain
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: lea_chain
    ; CHECK: $u = LEA16 $s, 17, 0, implicit-def $cc
    ; CHECK-NEXT: RTS implicit killed $u
    $u = LEA16 $s, 13, 0, implicit-def $cc
    $u = LEA16 $u, 4, 0, implicit-def $cc
    RTS implicit $u
...
---
name: lea_three
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x
    ; CHECK-LABEL: name: lea_three
    ; CHECK: liveins: $x
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x = LEA16 killed $x, -1, 0, implicit-def $cc
    ; CHECK-NEXT: RTS implicit killed $x
    $x = LEA16 $x, 2, 0, implicit-def $cc
    $x = LEA16 $x, 0, 0, implicit-def $cc
    $x = LEA16 $x, -3, 0, implicit-def $cc
    RTS implicit $x
...
---
name: lea_other_register
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: lea_other_register
    ; CHECK: $u = LEA16 $s, 13, 0, implicit-def $cc
    ; CHECK-NEXT: $x = LEA16 $u, 4, 0, implicit-def $cc
    ; CHECK-NEXT: RTS implicit $x, implicit $u
    $u = LEA16 $s, 13, 0, implicit-def $cc
    $x = LEA16 $u, 4, 0, implicit-def $cc
    RTS implicit $x, implicit $u
...
---
name: lea_postinc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x
    ; CHECK-LABEL: name: lea_postinc
    ; CHECK: liveins: $x
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x = LEA16 $x, 2, 0, implicit-def $cc
    ; CHECK-NEXT: $x = LEA16 $x, 0, 6, implicit-def $cc
    ; CHECK-NEXT: RTS implicit $x
    $x = LEA16 $x, 2, 0, implicit-def $cc
    $x = LEA16 $x, 0, 6, implicit-def $cc
    RTS implicit $x
...
---
name: lea_too_far
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x
    ; CHECK-LABEL: name: lea_too_far
    ; CHECK: liveins: $x
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x = LEA16 $x, 30000, 0, implicit-def $cc
    ; CHECK-NEXT: $x = LEA16 $x, 30000, 0, implicit-def $cc
    ; CHECK-NEXT: RTS implicit $x
    $x = LEA16 $x, 30000, 0, implicit-def $cc
    $x = LEA16 $x, 30000, 0, implicit-def $cc
    RTS implicit $x
...
