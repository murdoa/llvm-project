; RUN: llc -verify-machineinstrs -mtriple=m6809 -O0 < %s | FileCheck %s

; The compare takes a GR16 and the result of SEX, which must be in D. The
; fast allocator has to give D to the SEX result before the other operand
; can take it.

@g = global i16 0

define void @cmp_sext(i16 %n) {
; CHECK-LABEL: cmp_sext:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -4,s
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd g
; CHECK-NEXT:    std 2,s ; 2-byte Folded Spill
; CHECK-NEXT:    ldd g
; CHECK-NEXT:    pshs x
; CHECK-NEXT:    eora ,s+
; CHECK-NEXT:    eorb ,s+
; CHECK-NEXT:    sex
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd 2,s ; 2-byte Folded Reload
; CHECK-NEXT:    stx ,s
; CHECK-NEXT:    cmpd ,s
; CHECK-NEXT:    beq .LBB0_2
; CHECK-NEXT:    bra .LBB0_1
; CHECK-NEXT:  .LBB0_1: ; %yes
; CHECK-NEXT:    ldd #1
; CHECK-NEXT:    std g
; CHECK-NEXT:    leas 4,s
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_2: ; %no
; CHECK-NEXT:    leas 4,s
; CHECK-NEXT:    rts
  %a = load volatile i16, ptr @g
  %b = load volatile i16, ptr @g
  %x = xor i16 %b, %n
  %t = trunc i16 %x to i8
  %s = sext i8 %t to i16
  %c = icmp ne i16 %a, %s
  br i1 %c, label %yes, label %no
yes:
  store volatile i16 1, ptr @g
  ret void
no:
  ret void
}
