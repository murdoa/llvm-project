; Ordered i32 compares are a 32-bit subtraction (subd, then sbcb/sbca) and
; one branch on its flags. GT, LE, HI and LS swap the operands, or move a
; constant by one; a zero low half compares only the high halves.

declare void @f()

define void @br_slt(i32 %a, i32 %b) {
; CHECK-LABEL: br_slt:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd 2,s
; CHECK-NEXT:    subd 6,s
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    sbcb 5,s
; CHECK-NEXT:    sbca 4,s
; CHECK-NEXT:    bge .LBB0_2
; CHECK-NEXT:  ; %bb.1: ; %t
; CHECK-NEXT:    jsr f
; CHECK-NEXT:  .LBB0_2: ; %e
; CHECK-NEXT:    rts
  %c = icmp slt i32 %a, %b
  br i1 %c, label %t, label %e
t:
  call void @f()
  br label %e
e:
  ret void
}

