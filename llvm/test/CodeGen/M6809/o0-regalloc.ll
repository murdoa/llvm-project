; RUN: llc -verify-machineinstrs -mtriple=m6809 -O0 < %s | FileCheck %s

; Cases where the fast register allocator once ran out of registers.

; Both halves of the result are computed in D.
define i32 @ret_both_in_d(i16 %a, i16 %b) {
; CHECK-LABEL: ret_both_in_d:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    tfr d, y
; CHECK-NEXT:    sty ,s ; 2-byte Folded Spill
; CHECK-NEXT:    ldx 4,s
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    leay d,y
; CHECK-NEXT:    ldd ,s ; 2-byte Folded Reload
; CHECK-NEXT:    pshs x
; CHECK-NEXT:    subd ,s++
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    tfr y, d
; CHECK-NEXT:    leas 2,s
; CHECK-NEXT:    rts
  %hi = add i16 %a, %b
  %lo = sub i16 %a, %b
  %h = zext i16 %hi to i32
  %l = zext i16 %lo to i32
  %s = shl i32 %h, 16
  %r = or i32 %s, %l
  ret i32 %r
}

; Both operands of the compare are computed in D.
define i16 @cmp_both_in_d(i16 %a, i16 %b) {
; CHECK-LABEL: cmp_both_in_d:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    stx ,s ; 2-byte Folded Spill
; CHECK-NEXT:    ldy 4,s
; CHECK-NEXT:    tfr y, d
; CHECK-NEXT:    leax d,x
; CHECK-NEXT:    ldd ,s ; 2-byte Folded Reload
; CHECK-NEXT:    pshs y
; CHECK-NEXT:    subd ,s++
; CHECK-NEXT:    tfr d, y
; CHECK-NEXT:    pshs y
; CHECK-NEXT:    cmpx ,s++
; CHECK-NEXT:    bhs .LBB1_2
; CHECK-NEXT:    bra .LBB1_1
; CHECK-NEXT:  .LBB1_1: ; %t
; CHECK-NEXT:    ldd #1
; CHECK-NEXT:    leas 2,s
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB1_2: ; %f
; CHECK-NEXT:    ldd #0
; CHECK-NEXT:    leas 2,s
; CHECK-NEXT:    rts
  %x = add i16 %a, %b
  %y = sub i16 %a, %b
  %c = icmp ult i16 %x, %y
  br i1 %c, label %t, label %f
t:
  ret i16 1
f:
  ret i16 0
}

; %a stays live after the AND that is tied to it, with only A and B.
define i8 @tied_live_through(i8 %a, i8 %b) {
; CHECK-LABEL: tied_live_through:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr b, a
; CHECK-NEXT:    ldb 2,s
; CHECK-NEXT:    pshs a
; CHECK-NEXT:    orb ,s+
; CHECK-NEXT:    rts
  %x = and i8 %a, %b
  %y = xor i8 %x, %b
  %z = add i8 %y, %a
  ret i8 %z
}
