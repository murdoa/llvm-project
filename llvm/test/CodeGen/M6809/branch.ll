define i16 @count_down(i16 %n) {
; CHECK-LABEL: count_down:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    leas -4,s
; CHECK-NEXT:    std 2,s ; 2-byte Folded Spill
; CHECK-NEXT:    ldd #0
