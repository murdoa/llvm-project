; CHECK-NEXT:    ldd ,s ; 2-byte Folded Reload
; CHECK-NEXT:    addd #3
; CHECK-NEXT:    std ,s ; 2-byte Folded Spill
; CHECK-NEXT:    ldd 2,s ; 2-byte Folded Reload
; CHECK-NEXT:    cmpd #0
; CHECK-NEXT:    lbne .LBB6_1
; CHECK-NEXT:  ; %bb.2: ; %exit
; CHECK-NEXT:    ldd ,s ; 2-byte Folded Reload
; CHECK-NEXT:    leas 4,s
; CHECK-NEXT:    rts
entry:
  br label %loop
loop:
  %i = phi i16 [ %n, %entry ], [ %next, %loop ]
  %acc = phi i16 [ 0, %entry ], [ %sum, %loop ]
  %sum = add i16 %acc, 3
  %next = add i16 %i, -1
  %done = icmp eq i16 %next, 0
  br i1 %done, label %exit, label %loop
exit:
  ret i16 %sum
}
