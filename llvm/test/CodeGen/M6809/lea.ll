; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; Two counters in one loop: one stays in D, the other in an index register.
define i16 @two_counters(i16 %n) {
; CHECK-LABEL: two_counters:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd #0
; CHECK-NEXT:  .LBB0_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    leax -1,x
; CHECK-NEXT:    addd #3
; CHECK-NEXT:    cmpx #0
; CHECK-NEXT:    lbne .LBB0_1
; CHECK-NEXT:  ; %bb.2: ; %exit
; CHECK-NEXT:    rts
entry:
  br label %loop
loop:
  %i = phi i16 [ %n, %entry ], [ %next, %loop ]
  %acc = phi i16 [ 0, %entry ], [ %sum, %loop ]
  %sum = add i16 %acc, 3
  %next = add i16 %i, -1
  %done = icmp eq i16 %next, 0
  br i1 %done, label %exit, label %loop
exit:
  ret i16 %sum
}

; Walking a pointer through memory: leax 1,x.
define i8 @sum_bytes(ptr %p, i16 %n) {
; CHECK-LABEL: sum_bytes:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    tfr d, y
; CHECK-NEXT:    ldb #0
; CHECK-NEXT:    ldx 2,s
; CHECK-NEXT:  .LBB1_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    addb ,y
; CHECK-NEXT:    leax -1,x
; CHECK-NEXT:    leay 1,y
; CHECK-NEXT:    cmpx #0
; CHECK-NEXT:    lbne .LBB1_1
; CHECK-NEXT:  ; %bb.2: ; %exit
; CHECK-NEXT:    rts
entry:
  br label %loop
loop:
  %q = phi ptr [ %p, %entry ], [ %q.next, %loop ]
  %i = phi i16 [ %n, %entry ], [ %i.next, %loop ]
  %acc = phi i8 [ 0, %entry ], [ %acc.next, %loop ]
  %v = load i8, ptr %q
  %acc.next = add i8 %acc, %v
  %q.next = getelementptr i8, ptr %q, i16 1
  %i.next = add i16 %i, -1
  %done = icmp eq i16 %i.next, 0
  br i1 %done, label %exit, label %loop
exit:
  ret i8 %acc.next
}

; Address of a local.
define ptr @addr_of_local() {
; CHECK-LABEL: addr_of_local:
