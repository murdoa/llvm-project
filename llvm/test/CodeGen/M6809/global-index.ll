; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; An array indexed by a register. A 16-bit index goes in an index register
; with the symbol as the offset, "ldb tab,x", rather than the symbol in D. A
; zero-extended byte index is added with ABX, and neighbouring elements
; share the sum: "ldb ,x; addb 1,x".

@tab = global [16 x i8] zeroinitializer
@wtab = global [16 x i16] zeroinitializer

define i8 @word_index(ptr %p) {
; CHECK-LABEL: word_index:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldx ,x
; CHECK-NEXT:    ldb tab,x
; CHECK-NEXT:    rts
  %i = load i16, ptr %p
  %q = getelementptr i8, ptr @tab, i16 %i
  %v = load i8, ptr %q
  ret i8 %v
}

define i8 @byte_index(i8 %i) {
; CHECK-LABEL: byte_index:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldx #tab
; CHECK-NEXT:    abx
; CHECK-NEXT:    ldb ,x
; CHECK-NEXT:    rts
  %w = zext i8 %i to i16
  %q = getelementptr i8, ptr @tab, i16 %w
  %v = load i8, ptr %q
  ret i8 %v
}

define i8 @byte_index_pair(i8 %i) {
; CHECK-LABEL: byte_index_pair:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldx #tab
; CHECK-NEXT:    abx
; CHECK-NEXT:    ldb ,x
; CHECK-NEXT:    addb 1,x
; CHECK-NEXT:    rts
  %w = zext i8 %i to i16
  %q = getelementptr i8, ptr @tab, i16 %w
  %v = load i8, ptr %q
  %q1 = getelementptr i8, ptr %q, i16 1
  %v1 = load i8, ptr %q1
  %s = add i8 %v, %v1
  ret i8 %s
}

define ptr @byte_index_address(i8 %i) {
; CHECK-LABEL: byte_index_address:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldx #tab
; CHECK-NEXT:    abx
; CHECK-NEXT:    leax 2,x
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    rts
  %w = zext i8 %i to i16
  %q = getelementptr i8, ptr @tab, i16 %w
  %q2 = getelementptr i8, ptr %q, i16 2
  ret ptr %q2
}

define void @store_word(ptr %p, i16 %v) {
; CHECK-LABEL: store_word:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd ,x
; CHECK-NEXT:    aslb
; CHECK-NEXT:    rola
; CHECK-NEXT:    ldy 2,s
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    sty wtab,x
; CHECK-NEXT:    rts
  %i = load i16, ptr %p
  %q = getelementptr i16, ptr @wtab, i16 %i
  store i16 %v, ptr %q
  ret void
}
