; 16-bit logic with an immediate skips a byte that does not change, and
; uses com or ld for a byte that is flipped or set.
define i16 @xor16_ff00(i16 %a) {
; CHECK-LABEL: xor16_ff00:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    coma
; CHECK-NEXT:    rts
  %r = xor i16 %a, -256
  ret i16 %r
}

define i16 @or16_00ff(i16 %a) {
; CHECK-LABEL: or16_00ff:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldb #255
; CHECK-NEXT:    rts
