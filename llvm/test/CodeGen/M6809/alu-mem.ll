}

; arr+8 is the high byte and arr+9 the low byte.
define i16 @and16_global_offset(i16 %a) {
; M6809-LABEL: and16_global_offset:
; M6809:       ; %bb.0:
; M6809-NEXT:    anda arr+8
; M6809-NEXT:    andb arr+9
; M6809-NEXT:    rts
;
; H6309-LABEL: and16_global_offset:
; H6309:       ; %bb.0:
; H6309-NEXT:    andd arr+8
; H6309-NEXT:    rts
  %q = getelementptr i16, ptr @arr, i16 4
  %v = load i16, ptr %q
  %r = and i16 %a, %v
  ret i16 %r
}

