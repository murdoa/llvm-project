; Arithmetic and logic with a memory operand: extended addressing for a
; global (with a constant offset folded into the symbol), indexed for a
; pointer, and absolute addresses. The 6809 does 16-bit logic on memory as
; two byte operations, high byte first at the lower address; the HD6309
; has andd, ord and eord.

@g8 = global i8 0
@g16 = global i16 0
@arr = global [10 x i16] zeroinitializer

define i8 @sub8_global(i8 %a) {
; CHECK-LABEL: sub8_global:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    subb g8
; CHECK-NEXT:    rts
  %v = load i8, ptr @g8
  %r = sub i8 %a, %v
  ret i8 %r
}

define i8 @and8_ptr(i8 %a, ptr %p) {
; CHECK-LABEL: and8_ptr:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldx 2,s
; CHECK-NEXT:    andb ,x
; CHECK-NEXT:    rts
  %v = load i8, ptr %p
  %r = and i8 %a, %v
  ret i8 %r
}

define i8 @xor8_imm(i8 %a) {
; CHECK-LABEL: xor8_imm:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    eorb #85
; CHECK-NEXT:    rts
  %r = xor i8 %a, 85
  ret i8 %r
}

define i16 @add16_global(i16 %a) {
; CHECK-LABEL: add16_global:
