; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; U, the callee-saved register, is pushed in the prologue and pulled in
; the epilogue, where the return folds in: "puls u,pc". When optimizing for
; size, a small frame rides on the same push and pull: the prologue pushes
; spare registers, and the epilogue pulls into registers that are dead at
; the return (never into the registers that hold the result).

declare void @g(i16)
declare void @use(ptr)

define i16 @save_u(i16 %a) minsize {
; CHECK-LABEL: save_u:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshs u
; CHECK-NEXT:    tfr d, u
; CHECK-NEXT:    jsr g
; CHECK-NEXT:    tfr u, d
; CHECK-NEXT:    jsr g
; CHECK-NEXT:    tfr u, d
; CHECK-NEXT:    puls u,pc
  call void @g(i16 %a)
  call void @g(i16 %a)
  ret i16 %a
}

define i16 @frame_in_d(i16 %a) minsize {
; CHECK-LABEL: frame_in_d:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshs x,u
; CHECK-NEXT:    tfr d, u
; CHECK-NEXT:    stu ,s
; CHECK-NEXT:    jsr g
; CHECK-NEXT:    tfr u, d
; CHECK-NEXT:    jsr g
; CHECK-NEXT:    tfr u, d
; CHECK-NEXT:    addd ,s
; CHECK-NEXT:    puls x,u,pc
  %b = alloca i16
  store volatile i16 %a, ptr %b
  call void @g(i16 %a)
  call void @g(i16 %a)
  %v = load volatile i16, ptr %b
  %r = add i16 %v, %a
  ret i16 %r
}

define i32 @frame_in_dx(i32 %a) minsize {
; CHECK-LABEL: frame_in_dx:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshs x,y,u
; CHECK-NEXT:    std ,s ; 2-byte Folded Spill
; CHECK-NEXT:    leau 2,s
; CHECK-NEXT:    tfr u, d
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    tfr u, d
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    ldx 8,s
; CHECK-NEXT:    ldd ,s ; 2-byte Folded Reload
; CHECK-NEXT:    leas 4,s
; CHECK-NEXT:    puls u,pc
  %b = alloca i16
  call void @use(ptr %b)
  call void @use(ptr %b)
  ret i32 %a
}

define void @frame_void() minsize {
; CHECK-LABEL: frame_void:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -6,s
; CHECK-NEXT:    leax ,s
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    puls a,b,x,y,pc
  %b = alloca [6 x i8]
  call void @use(ptr %b)
  ret void
}

define void @frame_tail(i16 %a) minsize {
; CHECK-LABEL: frame_tail:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshs x,u
; CHECK-NEXT:    tfr d, u
; CHECK-NEXT:    leax ,s
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    tfr u, d
; CHECK-NEXT:    jsr g
; CHECK-NEXT:    tfr u, d
; CHECK-NEXT:    puls x,u
; CHECK-NEXT:    jmp g
  %b = alloca i16
  call void @use(ptr %b)
  call void @g(i16 %a)
  tail call void @g(i16 %a)
  ret void
}

; Without minsize the frame keeps its LEAS.
define i16 @not_minsize(i16 %a) {
; CHECK-LABEL: not_minsize:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    std ,s
; CHECK-NEXT:    jsr g
; CHECK-NEXT:    ldd ,s
; CHECK-NEXT:    leas 2,s
; CHECK-NEXT:    rts
  %b = alloca i16
  store volatile i16 %a, ptr %b
  call void @g(i16 %a)
  %v = load volatile i16, ptr %b
  ret i16 %v
}
