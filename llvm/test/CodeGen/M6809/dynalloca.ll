; A variable-sized object moves S, so the frame is addressed off U.

declare void @use(ptr, ptr)

define void @vla(i16 %n) {
; CHECK-LABEL: vla:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshs u
; CHECK-NEXT:    leau ,s
; CHECK-NEXT:    leas -4,s
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    tfr s, d
; CHECK-NEXT:    pshs x
; CHECK-NEXT:    subd ,s++
; CHECK-NEXT:    tfr d, s
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    std ,s
; CHECK-NEXT:    leax -4,u
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    leas 2,s
; CHECK-NEXT:    leas ,u
; CHECK-NEXT:    puls u
; CHECK-NEXT:    rts
  %fixed = alloca [4 x i8]
  %v = alloca i8, i16 %n
  call void @use(ptr %fixed, ptr %v)
  ret void
}

; Without one, U stays free and the frame is off S.
define void @novla() {
