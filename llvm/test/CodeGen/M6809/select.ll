; Each SELECT* pseudo becomes a compare-and-branch around the false value:
; 8- or 16-bit values chosen by an 8- or 16-bit compare, against a register
; or an immediate. A register-register compare on the 6809 pushes one
; operand and compares with ,s+ or ,s++; the HD6309 uses cmpr.

; 16-bit values, 16-bit register compare.
define i16 @v16_c16(i16 %a, i16 %b) {
; M6809-LABEL: v16_c16:
; M6809:       ; %bb.0:
; M6809-NEXT:    tfr d, y
; M6809-NEXT:    ldx 2,s
; M6809-NEXT:    ldd #7
; M6809-NEXT:    pshs x
; M6809-NEXT:    cmpy ,s++
; M6809-NEXT:    blt .LBB0_2
; M6809-NEXT:  ; %bb.1:
; M6809-NEXT:    ldd #9
; M6809-NEXT:  .LBB0_2:
; M6809-NEXT:    rts
;
; H6309-LABEL: v16_c16:
; H6309:       ; %bb.0:
; H6309-NEXT:    tfr d, y
; H6309-NEXT:    ldx 2,s
; H6309-NEXT:    ldd #7
; H6309-NEXT:    cmpr x, y
; H6309-NEXT:    blt .LBB0_2
; H6309-NEXT:  ; %bb.1:
; H6309-NEXT:    ldd #9
; H6309-NEXT:  .LBB0_2:
; H6309-NEXT:    rts
  %c = icmp slt i16 %a, %b
  %r = select i1 %c, i16 7, i16 9
  ret i16 %r
}

