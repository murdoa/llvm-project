; A constant on the left is moved to the right and the condition swapped:
; 5 > a is a < 5.
define i16 @const_lhs(i16 %a) {
; CHECK-LABEL: const_lhs:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldb #1
; CHECK-NEXT:    cmpx #5
; CHECK-NEXT:    blt .LBB5_2
; CHECK-NEXT:  ; %bb.1:
; CHECK-NEXT:    clrb
; CHECK-NEXT:  .LBB5_2:
; CHECK-NEXT:    ; kill: def $b killed $b def $d
; CHECK-NEXT:    clra
; CHECK-NEXT:    rts
  %c = icmp sgt i16 5, %a
  %r = select i1 %c, i16 1, i16 0
  ret i16 %r
}

; Selecting between two loaded values selects their addresses, then loads.
define i16 @v16_mem(i16 %a, i16 %x, i16 %y) {
; M6809-LABEL: v16_mem:
; M6809:       ; %bb.0:
; M6809-NEXT:    leay 4,s
; M6809-NEXT:    leax 2,s
; M6809-NEXT:    subd #0
; M6809-NEXT:    bne .LBB6_2
; M6809-NEXT:  ; %bb.1:
; M6809-NEXT:    tfr y, x
; M6809-NEXT:  .LBB6_2:
; M6809-NEXT:    ldd ,x
; M6809-NEXT:    rts
;
; H6309-LABEL: v16_mem:
; H6309:       ; %bb.0:
; H6309-NEXT:    leay 4,s
; H6309-NEXT:    leax 2,s
; H6309-NEXT:    tstd
; H6309-NEXT:    bne .LBB6_2
; H6309-NEXT:  ; %bb.1:
; H6309-NEXT:    tfr y, x
; H6309-NEXT:  .LBB6_2:
; H6309-NEXT:    ldd ,x
; H6309-NEXT:    rts
  %c = icmp ne i16 %a, 0
  %r = select i1 %c, i16 %x, i16 %y
  ret i16 %r
}

