; Repeated sequences in minsize functions are outlined: called with JSR, or
; jumped to when they end in a return. In a called sequence, offsets from S
; move by the two bytes of the return address.

@g = global [4 x i8] zeroinitializer
@h = global i16 0

declare void @use(i16, i16, i16)
declare void @take(ptr)
declare void @take2(ptr)
declare void @take3(ptr)

; The same bump of a ring index in three functions: called.
define void @f1() minsize {
  %i = load i8, ptr @g
  %j = add i8 %i, 1
  %k = and i8 %j, 7
  store i8 %k, ptr @g
  %a = load i16, ptr @h
  %b = add i16 %a, 300
  store i16 %b, ptr @h
  call void @use(i16 1, i16 2, i16 3)
  ret void
}

define void @f2() minsize {
  %i = load i8, ptr @g
  %j = add i8 %i, 1
  %k = and i8 %j, 7
  store i8 %k, ptr @g
  %a = load i16, ptr @h
  %b = add i16 %a, 300
  store i16 %b, ptr @h
  call void @use(i16 4, i16 5, i16 6)
  ret void
}

define void @f3() minsize {
  %i = load i8, ptr @g
  %j = add i8 %i, 1
  %k = and i8 %j, 7
  store i8 %k, ptr @g
  %a = load i16, ptr @h
  %b = add i16 %a, 300
  store i16 %b, ptr @h
  call void @use(i16 7, i16 8, i16 9)
  ret void
}

; The address of a local, taken inside the outlined function.
define void @t1() minsize {
  %a = alloca [3 x i16]
  %p1 = getelementptr i16, ptr %a, i16 1
  %p2 = getelementptr i16, ptr %a, i16 2
  store i16 1000, ptr %a
  store i16 2000, ptr %p1
  store i16 3000, ptr %p2
  call void @take(ptr %a)
  ret void
}
define void @t2() minsize {
  %a = alloca [3 x i16]
  %p1 = getelementptr i16, ptr %a, i16 1
  %p2 = getelementptr i16, ptr %a, i16 2
  store i16 1000, ptr %a
  store i16 2000, ptr %p1
  store i16 3000, ptr %p2
  call void @take2(ptr %a)
  ret void
}
define void @t3() minsize {
  %a = alloca [3 x i16]
  %p1 = getelementptr i16, ptr %a, i16 1
