; Copies and fills that are not inlined as loads and stores use TFM with
; the length in W, instead of calling memcpy or memset.

define void @copy40(ptr %d, ptr %s) {
; CHECK-LABEL: copy40:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, y
; CHECK-NEXT:    ldx 2,s
; CHECK-NEXT:    ldw #40
; CHECK-NEXT:    tfm x+, y+
; CHECK-NEXT:    rts
  call void @llvm.memcpy.p0.p0.i16(ptr %d, ptr %s, i16 40, i1 false)
  ret void
}

define void @copy_n(ptr %d, ptr %s, i16 %n) {
; CHECK-LABEL: copy_n:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, y
; CHECK-NEXT:    ldd 4,s
; CHECK-NEXT:    ldx 2,s
; CHECK-NEXT:    tfr d, w
; CHECK-NEXT:    tfm x+, y+
; CHECK-NEXT:    rts
  call void @llvm.memcpy.p0.p0.i16(ptr %d, ptr %s, i16 %n, i1 false)
  ret void
}

define void @fill40(ptr %d) {
