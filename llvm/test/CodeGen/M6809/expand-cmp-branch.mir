# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=m6809 -run-pass=post-ra-pseudos -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s --check-prefixes=CHECK,M6809
# RUN: llc -mtriple=m6809 -mcpu=6309 -run-pass=post-ra-pseudos -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s --check-prefixes=CHECK,H6309

# Expansion of the compare-and-branch pseudos after register allocation.
#
# SBCBR* is the high half of an i32 compare: sbcb/sbca (sbcd on the
# HD6309) then the branch. The subtraction overwrites D, so when D is
# still live after the branch it is pushed and pulled around it, and an
# S-relative operand moves up by the two pushed bytes.
#
# CB*ri against zero uses the shortest test that sets the flags the
# condition needs: tstb, subd #0 (tstd on the HD6309, except for unsigned
# conditions, as TSTD leaves C alone), leax ,x for EQ and NE on X or Y
# (LEAU sets no flags, so U needs cmpu #0), or nothing when the
# instruction before already set them.
#
# Condition codes: HS 2, EQ 5, GE 10, LT 11.

---
name: sbcbr_mem_d_live
tracksRegLiveness: true
body: |
  ; M6809-LABEL: name: sbcbr_mem_d_live
  ; M6809: bb.0:
  ; M6809-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; M6809-NEXT:   liveins: $d
  ; M6809-NEXT: {{  $}}
  ; M6809-NEXT:   PSHS16 $d, implicit-def $s, implicit $s
  ; M6809-NEXT:   $b = SBC8m $b, $s, 9, 0, implicit-def $cc, implicit $cc
  ; M6809-NEXT:   $a = SBC8m $a, $s, 8, 0, implicit-def $cc, implicit $cc, implicit $d, implicit-def $d
  ; M6809-NEXT:   $d = PULS16 implicit-def $s, implicit $s
  ; M6809-NEXT:   LBcc 10, %bb.2, implicit $cc
  ; M6809-NEXT: {{  $}}
  ; M6809-NEXT: bb.1:
  ; M6809-NEXT:   liveins: $d
  ; M6809-NEXT: {{  $}}
  ; M6809-NEXT:   RTS implicit $d
  ; M6809-NEXT: {{  $}}
  ; M6809-NEXT: bb.2:
  ; M6809-NEXT:   liveins: $d
  ; M6809-NEXT: {{  $}}
  ; M6809-NEXT:   RTS implicit $d
  ;
  ; H6309-LABEL: name: sbcbr_mem_d_live
  ; H6309: bb.0:
  ; H6309-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; H6309-NEXT:   liveins: $d
  ; H6309-NEXT: {{  $}}
  ; H6309-NEXT:   PSHS16 $d, implicit-def $s, implicit $s
  ; H6309-NEXT:   $d = SBCDm $d, $s, 8, 0, implicit-def $cc, implicit $cc
  ; H6309-NEXT:   $d = PULS16 implicit-def $s, implicit $s
  ; H6309-NEXT:   LBcc 10, %bb.2, implicit $cc
  ; H6309-NEXT: {{  $}}
  ; H6309-NEXT: bb.1:
  ; H6309-NEXT:   liveins: $d
  ; H6309-NEXT: {{  $}}
  ; H6309-NEXT:   RTS implicit $d
  ; H6309-NEXT: {{  $}}
  ; H6309-NEXT: bb.2:
  ; H6309-NEXT:   liveins: $d
  ; H6309-NEXT: {{  $}}
  ; H6309-NEXT:   RTS implicit $d
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $d
    SBCBRm $d, $s, 6, 0, 10, %bb.2, implicit-def $cc, implicit $cc
  bb.1:
    liveins: $d
    RTS implicit $d
  bb.2:
    liveins: $d
    RTS implicit $d
...
