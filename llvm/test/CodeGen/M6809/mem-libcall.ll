; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; On the 6809, memcpy, memset and memmove that are not inlined as loads
; and stores call the C library (hd6309-tfm.ll has the HD6309's TFM).

declare void @use(ptr)

; The fill value is an int: it goes in the outgoing area as 16 bits, with
; only the low byte defined.
define void @memset_var(ptr %d, i8 %v, i16 %n) {
; CHECK-LABEL: memset_var:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -4,s
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd 7,s
; CHECK-NEXT:    std 2,s
; CHECK-NEXT:    ldb 6,s
; CHECK-NEXT:    ; kill: def $b killed $b def $d
; CHECK-NEXT:    std ,s
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    jsr memset
; CHECK-NEXT:    leas 4,s
; CHECK-NEXT:    rts
  call void @llvm.memset.p0.i16(ptr %d, i8 %v, i16 %n, i1 false)
  ret void
}

define void @memcpy_var(ptr %d, ptr %s, i16 %n) {
; CHECK-LABEL: memcpy_var:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -4,s
; CHECK-NEXT:    ldx 8,s
; CHECK-NEXT:    stx 2,s
; CHECK-NEXT:    ldx 6,s
; CHECK-NEXT:    stx ,s
; CHECK-NEXT:    jsr memcpy
; CHECK-NEXT:    leas 4,s
; CHECK-NEXT:    rts
  call void @llvm.memcpy.p0.p0.i16(ptr %d, ptr %s, i16 %n, i1 false)
  ret void
}

define void @memcpy_volatile(ptr %d, ptr %s) {
; CHECK-LABEL: memcpy_volatile:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -4,s
; CHECK-NEXT:    ldx #64
; CHECK-NEXT:    stx 2,s
; CHECK-NEXT:    ldx 6,s
; CHECK-NEXT:    stx ,s
; CHECK-NEXT:    jsr memcpy
; CHECK-NEXT:    leas 4,s
; CHECK-NEXT:    rts
  call void @llvm.memcpy.p0.p0.i16(ptr %d, ptr %s, i16 64, i1 true)
  ret void
}

; A short constant fill is inlined as stores.
define void @memset_small(ptr %d) {
; CHECK-LABEL: memset_small:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd #0
; CHECK-NEXT:    std 4,x
; CHECK-NEXT:    std 2,x
; CHECK-NEXT:    std ,x
; CHECK-NEXT:    rts
  call void @llvm.memset.p0.i16(ptr %d, i8 0, i16 6, i1 false)
  ret void
}

; The local's address is kept in U, which is callee-saved, across both
; calls.
define void @memset_local() {
; CHECK-LABEL: memset_local:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -70,s
; CHECK-NEXT:    stu 68,s ; 2-byte Folded Spill
; CHECK-NEXT:    ldd #64
; CHECK-NEXT:    std 2,s
; CHECK-NEXT:    ldd #1
; CHECK-NEXT:    std ,s
; CHECK-NEXT:    leau 4,s
; CHECK-NEXT:    tfr u, d
; CHECK-NEXT:    jsr memset
; CHECK-NEXT:    tfr u, d
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    ldu 68,s ; 2-byte Folded Reload
; CHECK-NEXT:    leas 70,s
; CHECK-NEXT:    rts
  %a = alloca [64 x i8]
  call void @llvm.memset.p0.i16(ptr %a, i8 1, i16 64, i1 false)
  call void @use(ptr %a)
  ret void
}
