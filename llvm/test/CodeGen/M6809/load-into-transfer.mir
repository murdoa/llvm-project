# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=m6809 -run-pass=m6809-post-ra-cleanup -verify-machineinstrs %s -o - | FileCheck %s

# A load that only feeds a transfer loads the destination directly:
# "ldd 4,s; tfr d,x" is "ldx 4,s". Not when the loaded register is still
# live, nor when an auto-increment would change the destination.

---
name: d_dead
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $u
    ; CHECK-LABEL: name: d_dead
    ; CHECK: liveins: $u
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x = LD16m killed $u, 4, 0, implicit-def $cc :: (load (s16))
    ; CHECK-NEXT: $b = LD8m killed $x, 0, 0, implicit-def $cc
    ; CHECK-NEXT: RTS implicit killed $b
    $d = LD16m $u, 4, 0, implicit-def $cc :: (load (s16))
    $x = TFR16 $d
    $b = LD8m $x, 0, 0, implicit-def $cc
    RTS implicit $b
...
---
name: byte
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $u
    ; CHECK-LABEL: name: byte
    ; CHECK: liveins: $u
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $b = LD8m killed $u, 1, 0, implicit-def $cc :: (load (s8))
    ; CHECK-NEXT: RTS implicit killed $b
    $a = LD8m $u, 1, 0, implicit-def $cc :: (load (s8))
    $b = TFR8 $a
    RTS implicit $b
...
---
name: d_live
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $u
    ; CHECK-LABEL: name: d_live
    ; CHECK: liveins: $u
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $d = LD16m $u, 4, 0, implicit-def $cc :: (load (s16))
    ; CHECK-NEXT: $x = TFR16 $d
    ; CHECK-NEXT: $b = LD8m $x, 0, 0, implicit-def $cc
    ; CHECK-NEXT: RTS implicit $b, implicit $a
    $d = LD16m $u, 4, 0, implicit-def $cc :: (load (s16))
    $x = TFR16 $d
    $b = LD8m $x, 0, 0, implicit-def $cc
    RTS implicit $b, implicit $a
...
---
name: postinc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x
    ; CHECK-LABEL: name: postinc
    ; CHECK: liveins: $x
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $d = LD16m $x, 0, 7, implicit-def $cc :: (load (s16))
    ; CHECK-NEXT: $x = TFR16 $d
    ; CHECK-NEXT: $b = LD8m $x, 0, 0, implicit-def $cc
    ; CHECK-NEXT: RTS implicit $b
    $d = LD16m $x, 0, 7, implicit-def $cc :: (load (s16))
    $x = TFR16 $d
    $b = LD8m $x, 0, 0, implicit-def $cc
    RTS implicit $b
...
