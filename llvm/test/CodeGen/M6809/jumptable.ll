; A dense switch becomes a jump table and "jmp ,x".
define i16 @dense(i16 %x) {
; CHECK-LABEL: dense:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    cmpd #4
; CHECK-NEXT:    bhi .LBB0_7
; CHECK-NEXT:  ; %bb.1: ; %entry
; CHECK-NEXT:    aslb
; CHECK-NEXT:    rola
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldx .LJTI0_0,x
; CHECK-NEXT:    jmp ,x
; CHECK-NEXT:  .LBB0_2: ; %a
; CHECK-NEXT:    ldd #10
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_6: ; %e
; CHECK-NEXT:    ldd #54
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_4: ; %c
; CHECK-NEXT:    ldd #32
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_5: ; %d
; CHECK-NEXT:    ldd #43
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_3: ; %b
; CHECK-NEXT:    ldd #21
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_7: ; %def
; CHECK-NEXT:    ldd #0
; CHECK-NEXT:    rts
entry:
  switch i16 %x, label %def [
    i16 0, label %a
    i16 1, label %b
    i16 2, label %c
    i16 3, label %d
    i16 4, label %e
  ]
a:
  ret i16 10
b:
  ret i16 21
c:
  ret i16 32
d:
  ret i16 43
e:
  ret i16 54
def:
  ret i16 0
}

; Indexing a global uses it as the offset of an indexed address.
@tab = global [8 x i8] zeroinitializer
@wtab = global [8 x i16] zeroinitializer

define i8 @index8(i16 %i) {
; CHECK-LABEL: index8:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldb tab,x
; CHECK-NEXT:    rts
  %p = getelementptr i8, ptr @tab, i16 %i
  %v = load i8, ptr %p
  ret i8 %v
}

