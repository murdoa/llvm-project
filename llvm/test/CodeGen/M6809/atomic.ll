; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; There is no native atomic support yet: AtomicExpand turns every atomic
; operation into a call to the __atomic_* library functions, with the
; memory order (5 = seq_cst) as the last argument. llvm.trap calls abort.
;
; FIXME: AtomicExpand passes the order as an i32 (0 then 5 on the stack),
; but int is 16 bits on this target, so a C runtime reads order 0. Plain
; 8- and 16-bit loads and stores are already atomic on a single 6809.

define i16 @load16(ptr %p) {
; CHECK-LABEL: load16:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -4,s
; CHECK-NEXT:    ldx #5
; CHECK-NEXT:    stx 2,s
; CHECK-NEXT:    ldx #0
; CHECK-NEXT:    stx ,s
; CHECK-NEXT:    jsr __atomic_load_2
; CHECK-NEXT:    leas 4,s
; CHECK-NEXT:    rts
  %v = load atomic i16, ptr %p seq_cst, align 2
  ret i16 %v
}

define void @store8(ptr %p, i8 %v) {
; CHECK-LABEL: store8:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -5,s
; CHECK-NEXT:    tfr d, y
; CHECK-NEXT:    ldx #5
; CHECK-NEXT:    stx 3,s
; CHECK-NEXT:    ldx #0
; CHECK-NEXT:    stx 1,s
; CHECK-NEXT:    ldb 7,s
; CHECK-NEXT:    stb ,s
; CHECK-NEXT:    tfr y, d
; CHECK-NEXT:    jsr __atomic_store_1
; CHECK-NEXT:    leas 5,s
; CHECK-NEXT:    rts
  store atomic i8 %v, ptr %p seq_cst, align 1
  ret void
}

define i16 @fetch_add(ptr %p, i16 %v) {
; CHECK-LABEL: fetch_add:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -6,s
; CHECK-NEXT:    ldx #5
; CHECK-NEXT:    stx 4,s
; CHECK-NEXT:    ldx #0
; CHECK-NEXT:    stx 2,s
; CHECK-NEXT:    ldx 8,s
; CHECK-NEXT:    stx ,s
; CHECK-NEXT:    jsr __atomic_fetch_add_2
; CHECK-NEXT:    leas 6,s
; CHECK-NEXT:    rts
  %r = atomicrmw add ptr %p, i16 %v seq_cst
  ret i16 %r
}

define void @trap() {
; CHECK-LABEL: trap:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    jsr abort
  call void @llvm.trap()
  unreachable
}
