}

define void @fences() {
; CHECK-LABEL: fences:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ;MEMBARRIER
; CHECK-NEXT:    ;MEMBARRIER
; CHECK-NEXT:    rts
  fence seq_cst
  fence syncscope("singlethread") acquire
  ret void
}

define i8 @cmpxchg8(ptr %p, i8 %o, i8 %n) {
; CHECK-LABEL: cmpxchg8:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    ldx 4,s
; CHECK-NEXT:    stx ,s
; CHECK-NEXT:    jsr __sync_val_compare_and_swap_1
; CHECK-NEXT:    leas 2,s
; CHECK-NEXT:    rts
  %r = cmpxchg ptr %p, i8 %o, i8 %n seq_cst seq_cst
  %v = extractvalue {i8, i1} %r, 0
  ret i8 %v
}

