; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; One CPU, and an interrupt never splits an instruction: 8- and 16-bit
; atomic loads and stores are plain ones, and a fence emits nothing.
; Read-modify-write operations call the __sync_* functions.  Wider
; atomics call __atomic_*, with the memory order (5 = seq_cst) as a
; 16-bit int.  llvm.trap calls abort.

define i16 @load16(ptr %p) {
; CHECK-LABEL: load16:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd ,x
; CHECK-NEXT:    rts
  %v = load atomic i16, ptr %p seq_cst, align 2
  ret i16 %v
}

define void @store8(ptr %p, i8 %v) {
; CHECK-LABEL: store8:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldb 2,s
; CHECK-NEXT:    stb ,x
; CHECK-NEXT:    rts
  store atomic i8 %v, ptr %p seq_cst, align 1
  ret void
}

define i16 @fetch_add(ptr %p, i16 %v) {
; CHECK-LABEL: fetch_add:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    ldx 4,s
; CHECK-NEXT:    stx ,s
; CHECK-NEXT:    jsr __sync_fetch_and_add_2
; CHECK-NEXT:    leas 2,s
; CHECK-NEXT:    rts
  %r = atomicrmw add ptr %p, i16 %v seq_cst
  ret i16 %r
}

define void @trap() {
; CHECK-LABEL: trap:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    jsr abort
  call void @llvm.trap()
  unreachable
}

define i16 @load8_zext(ptr %p) {
; CHECK-LABEL: load8_zext:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldb ,x
; CHECK-NEXT:    ; kill: def $b killed $b def $d
; CHECK-NEXT:    clra
; CHECK-NEXT:    rts
  %v = load atomic i8, ptr %p acquire, align 1
  %z = zext i8 %v to i16
  ret i16 %z
}

define void @store16(ptr %p, i16 %v) {
; CHECK-LABEL: store16:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd 2,s
; CHECK-NEXT:    std ,x
; CHECK-NEXT:    rts
