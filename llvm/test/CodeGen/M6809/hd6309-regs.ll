define i64 @add64_imm(i64 %a) {
; CHECK-LABEL: add64_imm:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -4,s
; CHECK-NEXT:    stu 2,s ; 2-byte Folded Spill
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd #1
; CHECK-NEXT:    ldy #0
; CHECK-NEXT:    addd 12,s
; CHECK-NEXT:    std ,s ; 2-byte Folded Spill
; CHECK-NEXT:    tfr y, d
; CHECK-NEXT:    adcd 10,s
; CHECK-NEXT:    tfr d, w
; CHECK-NEXT:    tfr y, d
; CHECK-NEXT:    adcd 8,s
; CHECK-NEXT:    tfr d, u
; CHECK-NEXT:    tfr y, d
; CHECK-NEXT:    adcd 6,s
; CHECK-NEXT:    tfr d, y
; CHECK-NEXT:    ldd ,s ; 2-byte Folded Reload
; CHECK-NEXT:    std 6,x
; CHECK-NEXT:    stw 4,x
; CHECK-NEXT:    stu 2,x
; CHECK-NEXT:    sty ,x
; CHECK-NEXT:    ldu 2,s ; 2-byte Folded Reload
; CHECK-NEXT:    leas 4,s
; CHECK-NEXT:    rts
  %r = add i64 %a, 1
  ret i64 %r
}

; A loop counter in W counts down with addw.
define i16 @counter_in_w(ptr %a, ptr %b, ptr %c, ptr %d, i16 %n) {
; CHECK-LABEL: counter_in_w:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    leas -6,s
; CHECK-NEXT:    stu 4,s ; 2-byte Folded Spill
; CHECK-NEXT:    tfr d, u
; CHECK-NEXT:    clrd
; CHECK-NEXT:    std ,s ; 2-byte Folded Spill
; CHECK-NEXT:    ldw 14,s
; CHECK-NEXT:    ldd 10,s
; CHECK-NEXT:    std 2,s ; 2-byte Folded Spill
; CHECK-NEXT:    ldy 8,s
; CHECK-NEXT:  .LBB5_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldd ,u
; CHECK-NEXT:    addd ,y
; CHECK-NEXT:    ldx 2,s ; 2-byte Folded Reload
; CHECK-NEXT:    std ,x++
; CHECK-NEXT:    stx 2,s ; 2-byte Folded Spill
; CHECK-NEXT:    tfr u, x
; CHECK-NEXT:    ldu ,s ; 2-byte Folded Reload
; CHECK-NEXT:    leau d,u
; CHECK-NEXT:    stu ,s ; 2-byte Folded Spill
; CHECK-NEXT:    tfr x, u
; CHECK-NEXT:    leau 2,u
; CHECK-NEXT:    leay 2,y
; CHECK-NEXT:    addw #-1
; CHECK-NEXT:    cmpw #0
; CHECK-NEXT:    bne .LBB5_1
; CHECK-NEXT:  ; %bb.2: ; %exit
; CHECK-NEXT:    ldd ,s ; 2-byte Folded Reload
; CHECK-NEXT:    ldu 4,s ; 2-byte Folded Reload
; CHECK-NEXT:    leas 6,s
; CHECK-NEXT:    rts
entry:
  br label %loop
loop:
  %i = phi i16 [0, %entry], [%i1, %loop]
  %s = phi i16 [0, %entry], [%s1, %loop]
  %pa = getelementptr i16, ptr %a, i16 %i
  %pb = getelementptr i16, ptr %b, i16 %i
  %pc = getelementptr i16, ptr %c, i16 %i
  %va = load i16, ptr %pa
  %vb = load i16, ptr %pb
  %x = add i16 %va, %vb
  store i16 %x, ptr %pc
  %s1 = add i16 %s, %x
  %i1 = add i16 %i, 1
  %done = icmp eq i16 %i1, %n
  br i1 %done, label %exit, label %loop
exit:
  ret i16 %s1
}

; Inline asm can name W.
define i16 @asm_w(i16 %a) {
; CHECK-LABEL: asm_w:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, w
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    incw
; CHECK-EMPTY:
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    tfr w, d
; CHECK-NEXT:    rts
  %r = call i16 asm "incw", "={w},{w}"(i16 %a)
  ret i16 %r
}

; 8-bit register-register ops too: andr a,b.
define i8 @and8_regs(i8 %a, i8 %b, i8 %c, i8 %d) {
; CHECK-LABEL: and8_regs:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    lda 3,s
; CHECK-NEXT:    suba 4,s
; CHECK-NEXT:    addb 2,s
; CHECK-NEXT:    andr a, b
; CHECK-NEXT:    rts
  %x = add i8 %a, %b
  %y = sub i8 %c, %d
  %z = and i8 %x, %y
  ret i8 %z
}
