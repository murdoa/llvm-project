; adcd with a memory operand for the high half.
define i32 @add32_mem(i32 %a, i32 %b) {
; CHECK-LABEL: add32_mem:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, y
; CHECK-NEXT:    ldd 2,s
; CHECK-NEXT:    addd 6,s
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    tfr y, d
; CHECK-NEXT:    adcd 4,s
; CHECK-NEXT:    rts
  %r = add i32 %a, %b
  ret i32 %r
}

; The result of the low subtraction stays in W, and eorr combines it with D.
define i16 @sub_xor(ptr %p, ptr %q) {
; CHECK-LABEL: sub_xor:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd 2,x
; CHECK-NEXT:    ldy 2,s
; CHECK-NEXT:    subd 2,y
; CHECK-NEXT:    tfr d, w
; CHECK-NEXT:    ldd ,x
; CHECK-NEXT:    subd ,y
; CHECK-NEXT:    tfr w, x
; CHECK-NEXT:    eorr x, d
; CHECK-NEXT:    rts
  %a = load i16, ptr %p
  %b = load i16, ptr %q
  %pa = getelementptr i16, ptr %p, i16 1
  %qa = getelementptr i16, ptr %q, i16 1
  %c = load i16, ptr %pa
  %d = load i16, ptr %qa
  %x = sub i16 %a, %b
  %y = sub i16 %c, %d
  %z = xor i16 %x, %y
  ret i16 %z
}

