; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6809 -mcpu=6309 -verify-machineinstrs < %s | FileCheck %s

; HD6309 register use: W is a fifth allocatable 16-bit register, and the
; register-register ops (addr, adcr, subr, sbcr, eorr) work on any pair, so
; values need not pass through D. (select.ll has a copy from E, the high
; byte of W, with tfr e,b.)

; The low halves add with addr, the high halves with adcr.
define i32 @add32_regs(i32 %a, i32 %b) {
; CHECK-LABEL: add32_regs:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    stu ,s ; 2-byte Folded Spill
; CHECK-NEXT:    tfr d, w
; CHECK-NEXT:    ldd 8,s
; CHECK-NEXT:    ldx 6,s
; CHECK-NEXT:    asld
; CHECK-NEXT:    tfr d, u
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    rold
; CHECK-NEXT:    tfr d, y
; CHECK-NEXT:    ldd 4,s
; CHECK-NEXT:    asld
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    tfr w, d
; CHECK-NEXT:    rold
; CHECK-NEXT:    tfr u, w
; CHECK-NEXT:    addr w, x
; CHECK-NEXT:    adcr y, d
; CHECK-NEXT:    ldu ,s ; 2-byte Folded Reload
; CHECK-NEXT:    leas 2,s
; CHECK-NEXT:    rts
  %x = shl i32 %a, 1
  %y = shl i32 %b, 1
  %r = add i32 %x, %y
  ret i32 %r
}

