; CHECK-NEXT:    ldd 4,s
; CHECK-NEXT:    std 2,x
; CHECK-NEXT:    ldd 2,s
; CHECK-NEXT:    std ,x
; CHECK-NEXT:    rts
  ret double %a
}

; An explicit sret pointer is an ordinary first argument.
define void @sret(ptr sret(%struct.big) %p, i16 %v) {
; CHECK-LABEL: sret:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd 2,s
; CHECK-NEXT:    std ,x
; CHECK-NEXT:    rts
  store i16 %v, ptr %p
  ret void
}

; Calling a function that returns i64: the caller passes the address of a
; stack slot in D and reads the result back from it.
define i64 @call_i64() {
; CHECK-LABEL: call_i64:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -12,s
; CHECK-NEXT:    stu 10,s ; 2-byte Folded Spill
; CHECK-NEXT:    tfr d, u
; CHECK-NEXT:    leax 2,s
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    jsr get64
; CHECK-NEXT:    ldd 2,s
; CHECK-NEXT:    std ,s ; 2-byte Folded Spill
; CHECK-NEXT:    ldx 4,s
; CHECK-NEXT:    ldd 6,s
; CHECK-NEXT:    ldy 8,s
; CHECK-NEXT:    sty 6,u
; CHECK-NEXT:    std 4,u
; CHECK-NEXT:    stx 2,u
; CHECK-NEXT:    ldd ,s ; 2-byte Folded Reload
; CHECK-NEXT:    std ,u
; CHECK-NEXT:    ldu 10,s ; 2-byte Folded Reload
; CHECK-NEXT:    leas 12,s
; CHECK-NEXT:    rts
  %r = call i64 @get64()
  ret i64 %r
}
