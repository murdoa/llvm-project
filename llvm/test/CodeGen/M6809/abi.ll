; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; Corners of the calling convention described in the README: which
; argument gets the register, how 32-bit values and i1 travel, and results
; wider than 32 bits, which go through a hidden pointer passed in D.

%struct.big = type { [10 x i16] }

declare i16 @take_bytes(i8, i8, i16)
declare i64 @get64()

; Only the first argument gets a register. B holds the i8, so the i16 that
; follows is on the stack at 2,s, not in D.
define i16 @i8_then_i16(i8 %a, i16 %b) {
; CHECK-LABEL: i8_then_i16:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ; kill: def $b killed $b def $d
; CHECK-NEXT:    clra
; CHECK-NEXT:    addd 2,s
; CHECK-NEXT:    rts
  %e = zext i8 %a to i16
  %r = add i16 %e, %b
  ret i16 %r
}

; An i32 that is not the first argument is all on the stack, high word
; first (big-endian). The result's high word is in D, the low word in X.
define i32 @i32_second(i16 %a, i32 %b) {
; CHECK-LABEL: i32_second:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldd #1
; CHECK-NEXT:    ldy #0
; CHECK-NEXT:    addd 4,s
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    tfr y, d
; CHECK-NEXT:    adcb 3,s
; CHECK-NEXT:    adca 2,s
; CHECK-NEXT:    rts
  %r = add i32 %b, 1
  ret i32 %r
}

; A 32-bit first argument: high word in D, low word at 2,s.
define i16 @i32_first_low(i32 %a) {
; CHECK-LABEL: i32_first_low:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldd 2,s
; CHECK-NEXT:    rts
  %t = trunc i32 %a to i16
  ret i16 %t
}

; i1 is promoted to i8: it arrives and returns in B.
define i16 @i1_arg(i1 %c, i16 %a) {
; CHECK-LABEL: i1_arg:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    andb #1
; CHECK-NEXT:    bne .LBB3_1
; CHECK-NEXT:  ; %bb.2:
; CHECK-NEXT:    ldd #3
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB3_1:
; CHECK-NEXT:    ldd 2,s
; CHECK-NEXT:    rts
  %r = select i1 %c, i16 %a, i16 3
  ret i16 %r
}

define i1 @i1_ret(i16 %a) {
; CHECK-LABEL: i1_ret:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldb #1
; CHECK-NEXT:    cmpx #5
; CHECK-NEXT:    beq .LBB4_2
; CHECK-NEXT:  ; %bb.1:
; CHECK-NEXT:    clrb
; CHECK-NEXT:  .LBB4_2:
; CHECK-NEXT:    rts
  %c = icmp eq i16 %a, 5
  ret i1 %c
}

; Outgoing i8 arguments take one byte each in the packed argument area.
define i16 @call_bytes() {
; CHECK-LABEL: call_bytes:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -3,s
; CHECK-NEXT:    ldd #3
; CHECK-NEXT:    std 1,s
; CHECK-NEXT:    ldb #2
; CHECK-NEXT:    stb ,s
; CHECK-NEXT:    ldb #1
; CHECK-NEXT:    jsr take_bytes
; CHECK-NEXT:    leas 3,s
; CHECK-NEXT:    rts
  %r = call i16 @take_bytes(i8 1, i8 2, i16 3)
  ret i16 %r
}

; float is passed and returned like i32 and computed by a libcall.
define float @fadd(float %a, float %b) {
; CHECK-LABEL: fadd:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -6,s
; CHECK-NEXT:    ldx 12,s
; CHECK-NEXT:    stx 4,s
; CHECK-NEXT:    ldx 10,s
; CHECK-NEXT:    stx 2,s
; CHECK-NEXT:    ldx 8,s
; CHECK-NEXT:    stx ,s
; CHECK-NEXT:    jsr __addsf3
; CHECK-NEXT:    leas 6,s
; CHECK-NEXT:    rts
  %r = fadd float %a, %b
  ret float %r
}

; An i64 result is stored through the hidden pointer in D; the i64
; argument is on the stack at 2,s to 9,s.
define i64 @ret_i64(i64 %a) {
; CHECK-LABEL: ret_i64:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd 8,s
; CHECK-NEXT:    std 6,x
; CHECK-NEXT:    ldd 6,s
; CHECK-NEXT:    std 4,x
; CHECK-NEXT:    ldd 4,s
; CHECK-NEXT:    std 2,x
; CHECK-NEXT:    ldd 2,s
; CHECK-NEXT:    std ,x
; CHECK-NEXT:    rts
  ret i64 %a
}

define double @ret_double(double %a) {
; CHECK-LABEL: ret_double:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd 8,s
; CHECK-NEXT:    std 6,x
