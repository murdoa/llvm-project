; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; Block addresses load as an immediate (ldd #label), and indirectbr jumps
; through a register.

define ptr @addr() {
; CHECK-LABEL: addr:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldd #.Ltmp0
; CHECK-NEXT:    rts
  ret ptr blockaddress(@target, %l)
}

define void @target(ptr %p) {
; CHECK-LABEL: target:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    jmp ,x
; CHECK-NEXT:  .Ltmp0: ; Block address taken
; CHECK-NEXT:  .LBB1_1: ; %l
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB1_2: ; %m
; CHECK-NEXT:    jsr g
; CHECK-NEXT:    rts
entry:
  indirectbr ptr %p, [label %l, label %m]
l:
  ret void
m:
  call void @g()
  ret void
}

declare void @g()
