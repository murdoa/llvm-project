; RUN: llc -verify-machineinstrs -mtriple=m6809 -mcpu=6309 -O0 < %s | FileCheck %s

; The fast allocator cannot split live ranges, so a chain of HD6309
; register-register ops whose operands come from D-only instructions must
; not pin every value to D.

define i16 @chain(i16 %a, i16 %b, i16 %c, i16 %d) {
; CHECK-LABEL: chain:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    tfr d, w
; CHECK-NEXT:    ldy 4,s
; CHECK-NEXT:    ldd 8,s
; CHECK-NEXT:    std ,s ; 2-byte Folded Spill
; CHECK-NEXT:    ldd 6,s
; CHECK-NEXT:    eora #128
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd ,s ; 2-byte Folded Reload
; CHECK-NEXT:    orr w, x
; CHECK-NEXT:    eora #15
; CHECK-NEXT:    comb
; CHECK-NEXT:    orr y, d
; CHECK-NEXT:    orr x, d
; CHECK-NEXT:    leas 2,s
; CHECK-NEXT:    rts
  %x = xor i16 %c, -32768
  %y = or i16 %x, %a
  %z = xor i16 %d, 4095
  %w = or i16 %z, %b
  %r = or i16 %w, %y
  ret i16 %r
}

define i16 @tied_gr16(i16 %a, i16 %b) {
; CHECK-LABEL: tied_gr16:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    ldd 4,s
; CHECK-NEXT:    std ,s ; 2-byte Folded Spill
; CHECK-NEXT:    negd
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldd ,s ; 2-byte Folded Reload
; CHECK-NEXT:    andr x, d
; CHECK-NEXT:    leas 2,s
; CHECK-NEXT:    rts
  %n = sub i16 0, %b
  %r = and i16 %b, %n
  ret i16 %r
}
