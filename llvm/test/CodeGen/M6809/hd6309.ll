; RUN: llc -mtriple=m6809 -mcpu=6309 -verify-machineinstrs < %s | FileCheck %s

; With -mcpu=6309 one instruction replaces what the 6809 does in several:
; register-register arithmetic and compares (cmpr), 16-bit logic on memory
; (andd), negd and the D shifts, and muld for i16 multiply.

define i16 @add_rr(i16 %a, i16 %b, i16 %c) {
; CHECK-LABEL: add_rr:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, y
; CHECK-NEXT:    ldd 2,s
; CHECK-NEXT:    addd 4,s
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    tfr y, d
; CHECK-NEXT:    leax d,x
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    rts
  %s = add i16 %b, %c
  %t = add i16 %s, %a
  ret i16 %t
}

define i16 @and_rr(i16 %a, i16 %b) {
; CHECK-LABEL: and_rr:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    andd 4096
; CHECK-NEXT:    andd 4098
; CHECK-NEXT:    rts
  %x = load volatile i16, ptr inttoptr (i16 4096 to ptr)
  %r = and i16 %a, %x
  %y = load volatile i16, ptr inttoptr (i16 4098 to ptr)
  %s = and i16 %r, %y
  ret i16 %s
}

define i16 @and_mem(i16 %a, ptr %p) {
; CHECK-LABEL: and_mem:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldx 2,s
; CHECK-NEXT:    andd ,x
; CHECK-NEXT:    rts
  %x = load i16, ptr %p
  %r = and i16 %a, %x
  ret i16 %r
}

