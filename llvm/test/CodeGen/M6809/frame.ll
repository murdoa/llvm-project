; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -verify-machineinstrs -mtriple=m6809 < %s | FileCheck %s

; A local forces a frame: leas -N,s on entry, leas N,s before rts.
define i16 @local_i16(i16 %a) {
; CHECK-LABEL: local_i16:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    std ,s
; CHECK-NEXT:    ldd ,s
; CHECK-NEXT:    leas 2,s
; CHECK-NEXT:    rts
  %p = alloca i16
  store volatile i16 %a, ptr %p
  %v = load volatile i16, ptr %p
  ret i16 %v
}

; Stack arguments sit above the frame, so their offsets include its size.
define i8 @local_and_stack_arg(i16 %a, i8 %b) {
; CHECK-LABEL: local_and_stack_arg:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -1,s
; CHECK-NEXT:    ldb #7
; CHECK-NEXT:    stb ,s
; CHECK-NEXT:    ldb ,s
; CHECK-NEXT:    addb 3,s
; CHECK-NEXT:    leas 1,s
; CHECK-NEXT:    rts
  %p = alloca i8
  store volatile i8 7, ptr %p
  %v = load volatile i8, ptr %p
  %r = add i8 %v, %b
  ret i8 %r
}

; Lifetime markers refer to the stack object by TargetFrameIndex, which must
; not be selected as an address.
declare void @use(ptr)
define void @lifetime() {
; CHECK-LABEL: lifetime:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -6,s
; CHECK-NEXT:    leax ,s
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    leas 6,s
; CHECK-NEXT:    rts
  %buf = alloca [6 x i8], align 1
  call void @llvm.lifetime.start.p0(ptr %buf)
  call void @use(ptr %buf)
  call void @llvm.lifetime.end.p0(ptr %buf)
  ret void
}
