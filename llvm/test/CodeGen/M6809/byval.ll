; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

%struct.S = type { i16, i8, i16 }

declare void @take(i16, ptr byval(%struct.S))

; The first argument is in D, so the struct starts just above the return
; address, at 2,s.
define i8 @field(i16 %x, ptr byval(%struct.S) %s) {
; CHECK-LABEL: field:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldb 4,s
; CHECK-NEXT:    rts
  %p = getelementptr inbounds i8, ptr %s, i16 2
  %v = load i8, ptr %p
  ret i8 %v
}

; The caller copies the struct into the outgoing argument area.
define void @pass(ptr %s) {
; CHECK-LABEL: pass:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -5,s
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ldb 4,x
; CHECK-NEXT:    stb 4,s
; CHECK-NEXT:    ldd 2,x
; CHECK-NEXT:    std 2,s
; CHECK-NEXT:    ldd ,x
; CHECK-NEXT:    std ,s
; CHECK-NEXT:    ldd #7
; CHECK-NEXT:    jsr take
; CHECK-NEXT:    leas 5,s
; CHECK-NEXT:    rts
  call void @take(i16 7, ptr byval(%struct.S) %s)
  ret void
}
