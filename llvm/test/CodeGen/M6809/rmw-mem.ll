; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; Byte read-modify-write operations go straight to memory: clr, inc, dec,
; com and neg on an indexed or extended address. A volatile location (a
; hardware register, which may notice the extra read CLR makes) keeps the
; plain load and store.

@g8 = global i8 0

define void @clear(ptr %p) {
; CHECK-LABEL: clear:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    clr g8
; CHECK-NEXT:    clr 3,x
; CHECK-NEXT:    rts
  store i8 0, ptr @g8
  %q = getelementptr i8, ptr %p, i16 3
  store i8 0, ptr %q
  ret void
}

define void @increment(ptr %p) {
; CHECK-LABEL: increment:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    inc g8
; CHECK-NEXT:    dec 2,x
; CHECK-NEXT:    rts
  %v = load i8, ptr @g8
  %w = add i8 %v, 1
  store i8 %w, ptr @g8
  %q = getelementptr i8, ptr %p, i16 2
  %x = load i8, ptr %q
  %y = add i8 %x, -1
  store i8 %y, ptr %q
  ret void
}

define void @complement_negate(ptr %p) {
; CHECK-LABEL: complement_negate:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    com ,x
; CHECK-NEXT:    neg g8
; CHECK-NEXT:    rts
  %v = load i8, ptr %p
  %w = xor i8 %v, -1
  store i8 %w, ptr %p
  %x = load i8, ptr @g8
  %y = sub i8 0, %x
  store i8 %y, ptr @g8
  ret void
}

define void @volatile_kept(ptr %p) {
; CHECK-LABEL: volatile_kept:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    clrb
; CHECK-NEXT:    stb ,x
; CHECK-NEXT:    ldb #1
; CHECK-NEXT:    addb g8
; CHECK-NEXT:    stb g8
; CHECK-NEXT:    rts
  store volatile i8 0, ptr %p
  %v = load volatile i8, ptr @g8
  %w = add i8 %v, 1
  store volatile i8 %w, ptr @g8
  ret void
}
