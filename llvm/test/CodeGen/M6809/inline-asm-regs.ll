; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; Inline asm operands besides the constraint letters in inline-asm.ll:
; explicit registers, immediates and symbols, and clobbers. Clobbering U,
; which is callee-saved, makes the function save and restore it.

@g = global i16 0

define i16 @explicit_x(i16 %a) {
; CHECK-LABEL: explicit_x:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    leax 5,x
; CHECK-EMPTY:
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    rts
  %r = call i16 asm "leax $1,x", "={x},i,{x}"(i16 5, i16 %a)
  ret i16 %r
}

define i16 @imm_n(i16 %a) {
; CHECK-LABEL: imm_n:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    addd #300
; CHECK-EMPTY:
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    rts
  %r = call i16 asm "addd #$1", "=d,n,0"(i16 300, i16 %a)
  ret i16 %r
}

define void @symbol() {
; CHECK-LABEL: symbol:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    ldd g
; CHECK-EMPTY:
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    rts
  call void asm sideeffect "ldd $0", "i"(ptr @g)
  ret void
}

define void @clobber_u() {
; CHECK-LABEL: clobber_u:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    stu ,s ; 2-byte Folded Spill
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    nop
; CHECK-EMPTY:
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    ldu ,s ; 2-byte Folded Reload
; CHECK-NEXT:    leas 2,s
; CHECK-NEXT:    rts
  call void asm sideeffect "nop", "~{x},~{y},~{u}"()
  ret void
}
