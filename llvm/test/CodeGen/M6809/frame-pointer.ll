; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6809 -verify-machineinstrs < %s | FileCheck %s

; Frames with a frame pointer, which a variable-sized object forces:
;
;   pshs u; leau ,s; leas -n,s   ...   leas ,u; puls u
;
; U points at the saved U, so the return address is at 2,u, the first stack
; argument at 4,u and the locals and spill slots below U. Calls inside such
; a function allocate their outgoing area with leas around the call. Also
; large frames without a frame pointer.

%S = type { i16, i8 }

declare void @use(ptr)
declare void @use3(ptr, i16, i16)

; Stack arguments are addressed off U: %b at 4,u. The call's outgoing area
; is allocated below the dynamic object with leas -4,s.
define i16 @stack_arg(i16 %n, i16 %b) {
; CHECK-LABEL: stack_arg:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshs u
; CHECK-NEXT:    leau ,s
; CHECK-NEXT:    leas -2,s
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    tfr s, d
; CHECK-NEXT:    stx -2,u
; CHECK-NEXT:    subd -2,u
; CHECK-NEXT:    tfr d, s
; CHECK-NEXT:    leas -4,s
; CHECK-NEXT:    stx 2,s
; CHECK-NEXT:    ldx 4,u
; CHECK-NEXT:    stx ,s
; CHECK-NEXT:    jsr use3
; CHECK-NEXT:    leas 4,s
; CHECK-NEXT:    ldd 4,u
; CHECK-NEXT:    leas ,u
; CHECK-NEXT:    puls u
; CHECK-NEXT:    rts
  %p = alloca i8, i16 %n
  call void @use3(ptr %p, i16 %b, i16 %n)
  ret i16 %b
}

; A fixed local sits at -2,u, below the saved U.
define i16 @local(i16 %n) {
; CHECK-LABEL: local:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshs u
; CHECK-NEXT:    leau ,s
; CHECK-NEXT:    leas -6,s
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    tfr s, d
; CHECK-NEXT:    stx -6,u
; CHECK-NEXT:    subd -6,u
; CHECK-NEXT:    std -4,u ; 2-byte Folded Spill
; CHECK-NEXT:    tfr d, s
; CHECK-NEXT:    leax -2,u
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    ldd -4,u ; 2-byte Folded Reload
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    ldd -2,u
; CHECK-NEXT:    leas ,u
; CHECK-NEXT:    puls u
; CHECK-NEXT:    rts
  %l = alloca i16
  %p = alloca i8, i16 %n
  call void @use(ptr %l)
  call void @use(ptr %p)
  %v = load i16, ptr %l
  ret i16 %v
}

; A byval argument is in the caller's frame: its second field is at 6,u.
define i8 @byval(i16 %n, ptr byval(%S) %s) {
; CHECK-LABEL: byval:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshs u
; CHECK-NEXT:    leau ,s
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    tfr s, d
; CHECK-NEXT:    pshs x
; CHECK-NEXT:    subd ,s++
; CHECK-NEXT:    tfr d, s
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    ldb 6,u
; CHECK-NEXT:    leas ,u
; CHECK-NEXT:    puls u
; CHECK-NEXT:    rts
  %p = alloca i8, i16 %n
  call void @use(ptr %p)
  %q = getelementptr %S, ptr %s, i16 0, i32 1
  %v = load i8, ptr %q
  ret i8 %v
}

; The frame address is the address of the return address, 2,u, and the
; return address is loaded from there.
define ptr @frameaddr(i16 %n) {
; CHECK-LABEL: frameaddr:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshs u
; CHECK-NEXT:    leau ,s
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    tfr s, d
; CHECK-NEXT:    pshs x
; CHECK-NEXT:    subd ,s++
; CHECK-NEXT:    tfr d, s
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    leax 2,u
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    leas ,u
; CHECK-NEXT:    puls u
; CHECK-NEXT:    rts
  %p = alloca i8, i16 %n
  call void @use(ptr %p)
  %f = call ptr @llvm.frameaddress.p0(i32 0)
  ret ptr %f
}

define ptr @retaddr(i16 %n) {
; CHECK-LABEL: retaddr:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshs u
; CHECK-NEXT:    leau ,s
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    tfr s, d
; CHECK-NEXT:    pshs x
; CHECK-NEXT:    subd ,s++
; CHECK-NEXT:    tfr d, s
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    ldd 2,u
; CHECK-NEXT:    leas ,u
; CHECK-NEXT:    puls u
; CHECK-NEXT:    rts
  %p = alloca i8, i16 %n
  call void @use(ptr %p)
  %f = call ptr @llvm.returnaddress(i32 0)
  ret ptr %f
}

; stacksave copies S out and stackrestore copies it back.
define void @save_restore(i16 %n) {
; CHECK-LABEL: save_restore:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshs u
; CHECK-NEXT:    leau ,s
; CHECK-NEXT:    leas -4,s
; CHECK-NEXT:    tfr d, x
; CHECK-NEXT:    tfr s, d
; CHECK-NEXT:    std -2,u ; 2-byte Folded Spill
; CHECK-NEXT:    tfr s, d
; CHECK-NEXT:    stx -4,u
; CHECK-NEXT:    subd -4,u
; CHECK-NEXT:    tfr d, s
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    ldd -2,u ; 2-byte Folded Reload
; CHECK-NEXT:    tfr d, s
; CHECK-NEXT:    leas ,u
; CHECK-NEXT:    puls u
; CHECK-NEXT:    rts
  %s = call ptr @llvm.stacksave.p0()
  %p = alloca i8, i16 %n
  call void @use(ptr %p)
  call void @llvm.stackrestore.p0(ptr %s)
  ret void
}

; Without a frame pointer, offsets beyond the 8-bit range are fine: the
; indexed modes take a 16-bit offset.
define i8 @big_frame() {
; CHECK-LABEL: big_frame:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -300,s
; CHECK-NEXT:    leax ,s
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    ldb 250,s
; CHECK-NEXT:    leas 300,s
; CHECK-NEXT:    rts
  %a = alloca [300 x i8]
  call void @use(ptr %a)
  %p = getelementptr i8, ptr %a, i16 250
  %v = load i8, ptr %p
  ret i8 %v
}

; The incoming argument is above the 200-byte frame: 2 + 200 = 202,s.
define i16 @big_frame_arg(i16 %a, i16 %b) {
; CHECK-LABEL: big_frame_arg:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    leas -200,s
; CHECK-NEXT:    leax ,s
; CHECK-NEXT:    tfr x, d
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    ldd 202,s
; CHECK-NEXT:    leas 200,s
; CHECK-NEXT:    rts
  %x = alloca [200 x i8]
  call void @use(ptr %x)
  ret i16 %b
}
