; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; Copies between D and X: xgdx when the source dies, and through the stack
; ("pshb; psha; pulx" or "pshx; pula; pulb") when both stay live.

; D -> X, the source dies: xgdx.
define i8 @d_to_x(ptr %p) {
; CHECK-LABEL: d_to_x:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    ldab 0,x
; CHECK-NEXT:    rts
  %v = load i8, ptr %p
  ret i8 %v
}

; X -> D: the pointer is returned after being dereferenced.
define ptr @x_to_d(ptr %p) {
; CHECK-LABEL: x_to_d:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    clrb
; CHECK-NEXT:    stab 0,x
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    rts
  store i8 0, ptr %p
  ret ptr %p
}

; D -> X with D still live: through the stack.
define i16 @d_to_x_keep(ptr %p) {
; CHECK-LABEL: d_to_x_keep:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshb
; CHECK-NEXT:    psha
; CHECK-NEXT:    pulx
; CHECK-NEXT:    addd 0,x
; CHECK-NEXT:    rts
  %v = load i16, ptr %p
  %i = ptrtoint ptr %p to i16
  %r = add i16 %v, %i
  ret i16 %r
}

; The pointer stays in X across a computation in D.
define ptr @x_live_across_d(ptr %p) {
; CHECK-LABEL: x_live_across_d:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    ldd #1
; CHECK-NEXT:    addd 0,x
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    eora 0,x
; CHECK-NEXT:    eorb 1,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    std 0,x
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    rts
  %v = load i16, ptr %p
  %w = add i16 %v, 1
  %i = ptrtoint ptr %p to i16
  %r = xor i16 %w, %i
  store i16 %r, ptr %p
  ret ptr %p
}

; Constant offsets from a pointer fold into the indexed mode.
define i8 @x_plus_3(ptr %p) {
; CHECK-LABEL: x_plus_3:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    ldab 3,x
; CHECK-NEXT:    stab 6,x
; CHECK-NEXT:    rts
  %q = getelementptr i8, ptr %p, i16 3
  %v = load volatile i8, ptr %q
  %r = getelementptr i8, ptr %q, i16 3
  store volatile i8 %v, ptr %r
  ret i8 %v
}

; Pointer walk in a loop: the pointer stays in X and is bumped with inx.
define void @fill(ptr %p, i8 %n) {
; CHECK-LABEL: fill:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldab 4,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    beq .LBB5_2
; CHECK-NEXT:  .LBB5_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    stab 0,x
; CHECK-NEXT:    decb
; CHECK-NEXT:    inx
; CHECK-NEXT:    tstb
; CHECK-NEXT:    bne .LBB5_1
; CHECK-NEXT:  .LBB5_2: ; %done
; CHECK-NEXT:    rts
entry:
  %z = icmp eq i8 %n, 0
  br i1 %z, label %done, label %loop
loop:
  %q = phi ptr [ %p, %entry ], [ %q.next, %loop ]
  %i = phi i8 [ %n, %entry ], [ %i.next, %loop ]
  store i8 %i, ptr %q
  %q.next = getelementptr i8, ptr %q, i16 1
  %i.next = add i8 %i, -1
  %c = icmp ne i8 %i.next, 0
  br i1 %c, label %loop, label %done
done:
  ret void
}

; Two pointers take turns in X; storing X to a spill slot goes through D.
define void @copy_bytes(ptr %d, ptr %s) {
; CHECK-LABEL: copy_bytes:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 2,x ; 2-byte Folded Spill
; CHECK-NEXT:    ldx 6,x
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x ; 2-byte Folded Spill
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    ldab 0,x
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldx 2,x ; 2-byte Folded Reload
; CHECK-NEXT:    stab 0,x
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldx 0,x ; 2-byte Folded Reload
; CHECK-NEXT:    ldab 1,x
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldx 2,x ; 2-byte Folded Reload
; CHECK-NEXT:    stab 1,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
  %v = load i8, ptr %s
  store i8 %v, ptr %d
  %s1 = getelementptr i8, ptr %s, i16 1
  %d1 = getelementptr i8, ptr %d, i16 1
  %w = load i8, ptr %s1
  store i8 %w, ptr %d1
  ret void
}
