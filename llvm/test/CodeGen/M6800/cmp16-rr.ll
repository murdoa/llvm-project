; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; The loop-exit compare of two 16-bit values used to need its left side in
; D. The copy into D came just before the terminator, where the register
; allocator also had to move the loop's byte of state through a stack slot,
; and with D taken there was no accumulator left: "ran out of registers".
; Either side may now be in D or X.
define i16 @loop_exit(i16 %n, i1 %c, i8 %e, i16 %i) {
; CHECK-LABEL: loop_exit:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x ; 2-byte Folded Spill
; CHECK-NEXT:    clrb
; CHECK-NEXT:    stab 2,x ; 1-byte Folded Spill
; CHECK-NEXT:    ldab 7,x
; CHECK-NEXT:    ldaa 6,x
; CHECK-NEXT:    anda #1
; CHECK-NEXT:    staa 3,x ; 1-byte Folded Spill
; CHECK-NEXT:  .LBB0_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldaa 2,x ; 1-byte Folded Reload
; CHECK-NEXT:    beq .LBB0_4
; CHECK-NEXT:  .LBB0_2: ; %a
; CHECK-NEXT:    ; in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldaa 3,x ; 1-byte Folded Reload
; CHECK-NEXT:    beq .LBB0_3
; CHECK-NEXT:  .LBB0_4: ; %b
; CHECK-NEXT:    ; in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    cmpb #2
; CHECK-NEXT:    beq .LBB0_2
; CHECK-NEXT:  ; %bb.5: ; %b
; CHECK-NEXT:    ; in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    cmpb #1
; CHECK-NEXT:    beq .LBB0_8
; CHECK-NEXT:  ; %bb.6: ; in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    ldab #1
; CHECK-NEXT:    bra .LBB0_7
; CHECK-NEXT:  .LBB0_3: ; in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    clrb
; CHECK-NEXT:  .LBB0_7: ; %latch
; CHECK-NEXT:    ; in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    tsx
; CHECK-NEXT:    stab 2,x ; 1-byte Folded Spill
; CHECK-NEXT:    ldx 8,x
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldab 9,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    subd 2,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    bne .LBB0_1
; CHECK-NEXT:  .LBB0_8: ; %ret
; CHECK-NEXT:    ldd #0
; CHECK-NEXT:    pulx
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
entry:
  br label %loop

ret:
  ret i16 0

loop:
  %s = phi i8 [ %s.next, %latch ], [ 0, %entry ]
  %idle = icmp eq i8 %s, 0
  br i1 %idle, label %b, label %a

a:
  br i1 %c, label %b, label %latch

b:
  switch i8 %e, label %latch [
    i8 1, label %ret
    i8 2, label %a
  ]

latch:
  %s.next = phi i8 [ 0, %a ], [ 1, %b ]
  %done = icmp eq i16 %i, %n
  br i1 %done, label %ret, label %loop
}
