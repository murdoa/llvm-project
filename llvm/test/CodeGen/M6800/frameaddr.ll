; llvm.returnaddress(0) loads the word JSR pushed; llvm.frameaddress(0) is
; its address, above every local. Outer frames give 0: there is no frame
; chain to walk.


declare ptr @llvm.returnaddress(i32)
declare ptr @llvm.frameaddress.p0(i32)
declare void @use(ptr)

define ptr @ret0() {
; CHECK-LABEL: ret0:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldd 0,x
; CHECK-NEXT:    rts
  %r = call ptr @llvm.returnaddress(i32 0)
  ret ptr %r
}

define ptr @ret1() {
; CHECK-LABEL: ret1:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldd #0
; CHECK-NEXT:    rts
  %r = call ptr @llvm.returnaddress(i32 1)
  ret ptr %r
}

