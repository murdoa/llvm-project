; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; X plus a zero-extended byte in B is "abx"; an index into an array of
; words is two of them.

@bytes = global [256 x i8] zeroinitializer
@words = global [256 x i16] zeroinitializer

define i8 @byte_at(ptr %p, i8 %i) {
; CHECK-LABEL: byte_at:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldab 4,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    abx
; CHECK-NEXT:    ldab 0,x
; CHECK-NEXT:    rts
  %z = zext i8 %i to i16
  %a = getelementptr i8, ptr %p, i16 %z
  %v = load i8, ptr %a
  ret i8 %v
}

define i8 @table_byte(i8 %i) {
; CHECK-LABEL: table_byte:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldx #bytes
; CHECK-NEXT:    abx
; CHECK-NEXT:    ldab 0,x
; CHECK-NEXT:    rts
  %z = zext i8 %i to i16
  %a = getelementptr [256 x i8], ptr @bytes, i16 0, i16 %z
  %v = load i8, ptr %a
  ret i8 %v
}

define i16 @table_word(i8 %i) {
; CHECK-LABEL: table_word:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldx #words
; CHECK-NEXT:    abx
; CHECK-NEXT:    abx
; CHECK-NEXT:    ldd 0,x
; CHECK-NEXT:    rts
  %z = zext i8 %i to i16
  %a = getelementptr [256 x i16], ptr @words, i16 0, i16 %z
  %v = load i16, ptr %a
  ret i16 %v
}

define ptr @ptr_plus_byte(ptr %p, i8 %i) {
; CHECK-LABEL: ptr_plus_byte:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldab 4,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    abx
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    rts
  %z = zext i8 %i to i16
