; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_1: ; %t
; CHECK-NEXT:    jsr f
; CHECK-NEXT:    rts
  %c = icmp eq i8 %a, 0
  br i1 %c, label %t, label %e
t:
