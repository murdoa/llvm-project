; A loop: the counter is decremented and compared each time round.
define void @loop(i8 %n) {
; CHECK-LABEL: loop:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    tstb
; CHECK-NEXT:    beq .LBB22_2
; CHECK-NEXT:  .LBB22_1: ; %body
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    stab g8
; CHECK-NEXT:    decb
; CHECK-NEXT:    bne .LBB22_1
; CHECK-NEXT:  .LBB22_2: ; %done
; CHECK-NEXT:    rts
entry:
  %z = icmp eq i8 %n, 0
  br i1 %z, label %done, label %body
body:
  %i = phi i8 [ %n, %entry ], [ %i.next, %body ]
  store volatile i8 %i, ptr @g8
  %i.next = add i8 %i, -1
  %c = icmp ne i8 %i.next, 0
  br i1 %c, label %body, label %done
done:
  ret void
}

; A byte-wide countdown over an array, indexed through X.
define void @clear(ptr %p, i16 %n) {
; CHECK-LABEL: clear:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 2,x ; 2-byte Folded Spill
; CHECK-NEXT:    ldd 6,x
; CHECK-NEXT:    beq .LBB23_2
; CHECK-NEXT:  .LBB23_1: ; %body
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x ; 2-byte Folded Spill
; CHECK-NEXT:    clrb
; CHECK-NEXT:    ldx 2,x ; 2-byte Folded Reload
; CHECK-NEXT:    stab 0,x
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldd 2,x ; 2-byte Folded Reload
; CHECK-NEXT:    pulx
; CHECK-NEXT:    inx
; CHECK-NEXT:    pshb
; CHECK-NEXT:    psha
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 4,x ; 2-byte Folded Spill
; CHECK-NEXT:    pula
; CHECK-NEXT:    pulb
; CHECK-NEXT:    addd #-1
; CHECK-NEXT:    bne .LBB23_1
; CHECK-NEXT:  .LBB23_2: ; %done
; CHECK-NEXT:    pulx
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
entry:
  %z = icmp eq i16 %n, 0
  br i1 %z, label %done, label %body
body:
  %i = phi i16 [ 0, %entry ], [ %i.next, %body ]
  %q = getelementptr i8, ptr %p, i16 %i
  store i8 0, ptr %q
  %i.next = add i16 %i, 1
  %c = icmp ne i16 %i.next, %n
  br i1 %c, label %body, label %done
done:
  ret void
}

