; 16-bit arithmetic. Add and subtract exist only on D (addd/subd); with X
; as the other operand it is pushed and read back: "pshx; tsx; addd 0,x;
; pulx". There is no 16-bit and/or/eor: they are byte pairs on A then B.

define i16 @add_imm(i16 %a) {
; CHECK-LABEL: add_imm:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addd #1000
; CHECK-NEXT:    rts
  %r = add i16 %a, 1000
  ret i16 %r
}

define i16 @sub_imm(i16 %a) {
; CHECK-LABEL: sub_imm:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addd #-1000
; CHECK-NEXT:    rts
  %r = sub i16 %a, 1000
  ret i16 %r
}

