; Pointer arithmetic on X: inx/dex for small constants, otherwise
; "xgdx; addd #n; xgdx".
define i8 @load_x_plus_2(ptr %p) {
; CHECK-LABEL: load_x_plus_2:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    ldab 0,x
; CHECK-NEXT:    addb 1,x
; CHECK-NEXT:    rts
  %v = load i8, ptr %p
  %q = getelementptr i8, ptr %p, i16 1
  %w = load i8, ptr %q
  %s = add i8 %v, %w
  ret i8 %s
}

