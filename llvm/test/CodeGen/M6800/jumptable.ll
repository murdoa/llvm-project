; A dense switch becomes a jump table of 16-bit addresses: the index is
; doubled, the table address added, and "ldx 0,x; jmp 0,x". indirectbr is
; "jmp 0,x" too, and a block address is an immediate.

define i16 @dense(i16 %x) {
; CHECK-LABEL: dense:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    pshx
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    cpx #4
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    bhi .LBB0_7
; CHECK-NEXT:  ; %bb.1: ; %entry
; CHECK-NEXT:    asld
; CHECK-NEXT:    ldx #.LJTI0_0
; CHECK-NEXT:    pshb
; CHECK-NEXT:    psha
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 2,x ; 2-byte Folded Spill
; CHECK-NEXT:    pula
; CHECK-NEXT:    pulb
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldd 2,x ; 2-byte Folded Reload
; CHECK-NEXT:    pulx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    addd 0,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    ldx 0,x
; CHECK-NEXT:    jmp 0,x
; CHECK-NEXT:  .LBB0_2: ; %a
; CHECK-NEXT:    ldd #10
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_6: ; %e
; CHECK-NEXT:    ldd #54
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_4: ; %c
; CHECK-NEXT:    ldd #32
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_5: ; %d
; CHECK-NEXT:    ldd #43
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_3: ; %b
; CHECK-NEXT:    ldd #21
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_7: ; %def
; CHECK-NEXT:    ldd #0
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
entry:
  switch i16 %x, label %def [
    i16 0, label %a
    i16 1, label %b
    i16 2, label %c
    i16 3, label %d
    i16 4, label %e
  ]
a:
  ret i16 10
b:
  ret i16 21
c:
  ret i16 32
d:
  ret i16 43
e:
  ret i16 54
def:
  ret i16 0
}

