; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; A 16-bit product of which only the low byte is used is one "mul" of the
; low bytes, as is one shifted left by 8 or more.

define i8 @mul_trunc(i16 %a, i16 %b) {
; CHECK-LABEL: mul_trunc:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tba
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldab 3,x
; CHECK-NEXT:    mul
; CHECK-NEXT:    rts
  %m = mul i16 %a, %b
  %t = trunc i16 %m to i8
  ret i8 %t
}

define i16 @mul_shl8(i16 %a, i16 %b) {
; CHECK-LABEL: mul_shl8:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tba
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldab 3,x
; CHECK-NEXT:    mul
; CHECK-NEXT:    ; kill: def $b killed $b def $d
; CHECK-NEXT:    tba
; CHECK-NEXT:    clrb
; CHECK-NEXT:    rts
  %m = mul i16 %a, %b
  %s = shl i16 %m, 8
  ret i16 %s
}

; The low byte of %a is zero: only one partial product is left, even at
; minsize, where the full product is a library call.
define i16 @mul_low_zero(i8 %a, i16 %b) minsize {
; CHECK-LABEL: mul_low_zero:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tba
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldab 3,x
; CHECK-NEXT:    mul
; CHECK-NEXT:    ; kill: def $b killed $b def $d
; CHECK-NEXT:    tba
; CHECK-NEXT:    clrb
; CHECK-NEXT:    rts
  %z = zext i8 %a to i16
  %h = shl i16 %z, 8
  %m = mul i16 %h, %b
  ret i16 %m
}
