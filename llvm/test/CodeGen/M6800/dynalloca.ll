; CHECK-NEXT:    andb #248
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    txs
; CHECK-NEXT:    des
; CHECK-NEXT:    des
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x
; CHECK-NEXT:    xgdx
