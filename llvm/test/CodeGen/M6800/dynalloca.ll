; RUN: llc -mtriple=m6800 < %s | FileCheck %s

; A variable-sized object moves SP, so the frame is addressed off the frame
; pointer word __m6800_fp. The prologue saves the caller's value below the
; return address and the epilogue puts it back. Calls move SP themselves.

declare void @use(ptr, ptr)
declare i32 @get32(ptr)

define void @vla(i16 %n) {
; CHECK-LABEL: vla:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldx >__m6800_fp
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    stx >__m6800_fp
; CHECK-NEXT:    pshb
; CHECK-NEXT:    psha
; CHECK-NEXT:    tsx
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    subd 0,x
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    inx
; CHECK-NEXT:    inx
; CHECK-NEXT:    txs
; CHECK-NEXT:    des
; CHECK-NEXT:    des
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x
; CHECK-NEXT:    ldx >__m6800_fp
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    ins
; CHECK-NEXT:    ins
; CHECK-NEXT:    lds >__m6800_fp
; CHECK-NEXT:    pulx
; CHECK-NEXT:    ins
; CHECK-NEXT:    pulx
; CHECK-NEXT:    stx >__m6800_fp
; CHECK-NEXT:    rts
  %fixed = alloca [4 x i8]
  %v = alloca i8, i16 %n
  call void @use(ptr %fixed, ptr %v)
  ret void
}

