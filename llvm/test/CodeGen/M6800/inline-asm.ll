; Inline assembly constraints: "r" (A/B for i8, D/X for i16), "a" (X), "q"
; (an 8-bit accumulator), "d" (D, or B for i8) and "m" (a memory operand,
; printed as an extended or indexed address).

@g = global i16 0

define i8 @reg8(i8 %a) {
; CHECK-LABEL: reg8:
; CHECK:       ; %bb.0:
