; CHECK-NEXT:    incb
; CHECK-EMPTY:
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    rts
  %r = call i8 asm "inc$0", "=r,0"(i8 %a)
  ret i8 %r
}

