; i8 multiply is the HD6301 mul (D = A * B, low byte in B). i16 multiply
; and every divide and remainder call the runtime library; i8 divides are
; promoted to i16 first.

define i8 @mul8(i8 %a, i8 %b) {
; CHECK-LABEL: mul8:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tba
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldab 2,x
; CHECK-NEXT:    mul
; CHECK-NEXT:    rts
  %r = mul i8 %a, %b
  ret i8 %r
}

