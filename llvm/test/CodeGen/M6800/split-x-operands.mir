# RUN: llc -mtriple=m6800 -run-pass=m6800-split-d-operands -o - %s | FileCheck %s

# A tied source narrowed to X (here by its other use, as an address) is read
# through a GR16 copy. Otherwise the two-address pass pins the result to X
# as well, and storing it through an address in X has no assignment.

---
name: tied_x
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x
    ; CHECK-LABEL: name: tied_x
    ; CHECK: [[P:%[0-9]+]]:idx16 = COPY $x
    ; CHECK-NEXT: [[W:%[0-9]+]]:gr16 = COPY [[P]]
    ; CHECK-NEXT: [[V:%[0-9]+]]:gr16 = ADD16ri killed [[W]], 2
    ; CHECK-NEXT: ST16m [[V]], [[P]], 0, 0
    %0:idx16 = COPY $x
    %1:gr16 = ADD16ri %0, 2, implicit-def dead $cc
    ST16m %1, %0, 0, 0, implicit-def dead $cc
    RTS
...
