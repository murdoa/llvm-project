; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; Structs passed by value are copied into the packed argument area with
; byte alignment; the callee gets the address of its copy.

%struct.S = type { i16, i8, i16 }

declare void @take(i16, ptr byval(%struct.S))
declare void @take_first(ptr byval(%struct.S))

; The first argument is in D, so the struct starts just above the return
; address, at 2,x.
define i8 @field(i16 %x, ptr byval(%struct.S) %s) {
; CHECK-LABEL: field:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldab 4,x
; CHECK-NEXT:    rts
  %p = getelementptr inbounds i8, ptr %s, i16 2
  %v = load i8, ptr %p
  ret i8 %v
}

; A byval struct is never passed in a register, even as the first argument.
define i16 @field_first(ptr byval(%struct.S) %s) {
; CHECK-LABEL: field_first:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldd 5,x
; CHECK-NEXT:    rts
  %p = getelementptr inbounds i8, ptr %s, i16 3
  %v = load i16, ptr %p
  ret i16 %v
}

; The caller copies the struct into the outgoing argument area.
define void @pass(ptr %s) {
; CHECK-LABEL: pass:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    des
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    ldab 4,x
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    stab 6,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    ldd 2,x
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 4,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    ldd 0,x
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x
; CHECK-NEXT:    ldd #7
; CHECK-NEXT:    jsr take
; CHECK-NEXT:    pulx
; CHECK-NEXT:    pulx
; CHECK-NEXT:    ins
; CHECK-NEXT:    rts
  call void @take(i16 7, ptr byval(%struct.S) %s)
  ret void
}

define void @pass_first(ptr %s) {
; CHECK-LABEL: pass_first:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    des
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    ldab 4,x
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    stab 6,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    ldd 2,x
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 4,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    ldd 0,x
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x
; CHECK-NEXT:    jsr take_first
; CHECK-NEXT:    pulx
; CHECK-NEXT:    pulx
; CHECK-NEXT:    ins
; CHECK-NEXT:    rts
  call void @take_first(ptr byval(%struct.S) %s)
  ret void
}
