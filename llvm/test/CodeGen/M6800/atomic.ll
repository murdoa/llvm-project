; One CPU, and an interrupt never splits an instruction: 8- and 16-bit
; atomic loads and stores are plain ones, and a fence emits nothing.
; Read-modify-write operations call the __sync_* functions.  Wider
; atomics call __atomic_*, with the memory order (5 = seq_cst) as a
; 16-bit int.  llvm.trap calls abort.

define i16 @load16(ptr %p) {
; CHECK-LABEL: load16:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    ldd 0,x
; CHECK-NEXT:    rts
  %v = load atomic i16, ptr %p seq_cst, align 2
  ret i16 %v
}

