; Stack frames and stack slot access. Frames up to 8 bytes are allocated
; with pshx/des and freed with pulx/ins; larger ones move SP through D
; ("tsx; xgdx; subd #n; xgdx; txs"). Stack slots are "tsx" and "off,x",
; with X pushed around the access when it holds a live value, and offsets
; over 255 added to X.


declare void @use(ptr)
declare void @use8(i8)
declare void @fp8(ptr)
declare i32 @f32(i32)
declare void @g()

define void @frame1() {
; CHECK-LABEL: frame1:
