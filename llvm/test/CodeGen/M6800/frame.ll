; CHECK-NEXT:    tsx
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    ins
; CHECK-NEXT:    rts
  %a = alloca i8
  call void @use(ptr %a)
  ret void
}

