; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; Reduced from the c-torture test memset-2. The loop counter, going to D,
; once evicted the zero for the first store from B, taking it to fit in A.
; But A is half of D: the zero then had no register ("ran out of registers
; during register allocation").

@u = external global [31 x i8]

; CHECK-LABEL: main:
define i16 @main() minsize {
; CHECK-LABEL: main:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    ldd #0
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 4,x ; 2-byte Folded Spill
; CHECK-NEXT:  .LBB0_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 6,x ; 2-byte Folded Spill
; CHECK-NEXT:    clra
; CHECK-NEXT:    staa 0
; CHECK-NEXT:    ldx 4,x ; 2-byte Folded Reload
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 2,x
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldd 6,x ; 2-byte Folded Reload
; CHECK-NEXT:    ldx 4,x ; 2-byte Folded Reload
; CHECK-NEXT:    jsr 0,x
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldx 6,x ; 2-byte Folded Reload
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    addd #u
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    ldab #1
; CHECK-NEXT:    stab 0,x
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldx 4,x ; 2-byte Folded Reload
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 2,x
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pula
; CHECK-NEXT:    pulb
; CHECK-NEXT:    jsr 0,x
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldd 6,x ; 2-byte Folded Reload
; CHECK-NEXT:    addd #1
; CHECK-NEXT:    bra .LBB0_1
entry:
  br label %loop

loop:
  %off = phi i16 [ 0, %entry ], [ %inc, %loop ]
  %p = getelementptr i8, ptr @u, i16 %off
  store i8 0, ptr null, align 1
  call void null(i16 %off, i16 0, i16 0)
  store i8 1, ptr %p, align 1
  call void null(i16 0, i16 0, i16 0)
  %inc = add i16 %off, 1
  br label %loop
}
