; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; Size-optimized functions are scheduled in source order: here, the
; Solartron floating board's coefficient lookup comes out as the original
; ROM routine is written. Otherwise the register-pressure scheduler moves
; the load of $55 up between the two index steps.

@rows = global [14 x ptr] zeroinitializer

define void @coefficient(i8 zeroext %sel) optsize {
; CHECK-LABEL: coefficient:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldx #rows
; CHECK-NEXT:    abx
; CHECK-NEXT:    abx
; CHECK-NEXT:    ldx 0,x
; CHECK-NEXT:    ldab 107
; CHECK-NEXT:    abx
; CHECK-NEXT:    abx
; CHECK-NEXT:    dex
; CHECK-NEXT:    dex
; CHECK-NEXT:    ldab 85
; CHECK-NEXT:    stab 55
; CHECK-NEXT:    ldaa 0,x
; CHECK-NEXT:    ldab 55
; CHECK-NEXT:    mul
; CHECK-NEXT:    ; kill: def $b killed $b def $d
; CHECK-NEXT:    tba
; CHECK-NEXT:    clrb
; CHECK-NEXT:    std 58
; CHECK-NEXT:    ldab 1,x
; CHECK-NEXT:    ldaa 55
; CHECK-NEXT:    mul
; CHECK-NEXT:    addd 58
; CHECK-NEXT:    std 58
; CHECK-NEXT:    rts
  %i = zext i8 %sel to i16
  %ra = getelementptr inbounds [2 x i8], ptr @rows, i16 %i
  %row = load ptr, ptr %ra
  %col = load volatile i8, ptr inttoptr (i16 107 to ptr)
  %colz = zext i8 %col to i16
  %e = getelementptr [2 x i8], ptr %row, i16 %colz
  %e0 = getelementptr i8, ptr %e, i16 -2
  %s = load volatile i8, ptr inttoptr (i16 85 to ptr)
  store volatile i8 %s, ptr inttoptr (i16 55 to ptr)
  %hi = load i8, ptr %e0
  %hiz = zext i8 %hi to i16
  %s1 = load volatile i8, ptr inttoptr (i16 55 to ptr)
  %s1z = zext i8 %s1 to i16
  %hish = shl nuw i16 %hiz, 8
  %p0 = mul i16 %hish, %s1z
  store volatile i16 %p0, ptr inttoptr (i16 58 to ptr)
  %e1 = getelementptr i8, ptr %e, i16 -1
  %lo = load i8, ptr %e1
  %loz = zext i8 %lo to i16
  %s2 = load volatile i8, ptr inttoptr (i16 55 to ptr)
  %s2z = zext i8 %s2 to i16
  %p1 = mul nuw nsw i16 %s2z, %loz
  %old = load volatile i16, ptr inttoptr (i16 58 to ptr)
  %sum = add i16 %p1, %old
  store volatile i16 %sum, ptr inttoptr (i16 58 to ptr)
  ret void
}

