; Calls that share a return each get a copy of it, and a jump.
define void @shared_return(i8 %c) {
; CHECK-LABEL: shared_return:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tstb
; CHECK-NEXT:    beq .LBB5_1
; CHECK-NEXT:  ; %bb.2: ; %b
; CHECK-NEXT:    ldd #2
; CHECK-NEXT:    jmp g
; CHECK-NEXT:  .LBB5_1: ; %a
; CHECK-NEXT:    ldd #1
; CHECK-NEXT:    jmp g
  %z = icmp eq i8 %c, 0
  br i1 %z, label %a, label %b
a:
  tail call void @g(i16 1)
  br label %done
b:
  tail call void @g(i16 2)
  br label %done
done:
  ret void
}

