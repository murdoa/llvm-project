; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; With a frame pointer (the word __m6800_fp), stack slots are
; "ldx __m6800_fp" and "off,x"; FP does not move when X is pushed, so the
; offsets stay the same. Calls with stack arguments move SP themselves
; (des before, ins after), since the space below the fixed frame belongs to
; the allocas.


declare void @use(ptr)
declare void @f3(i16, i16, i8)

define void @vla_call(i16 %n, i16 %x) {
; CHECK-LABEL: vla_call:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldx >__m6800_fp
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    stx >__m6800_fp
; CHECK-NEXT:    ldx >__m6800_fp
; CHECK-NEXT:    std 0,x ; 2-byte Folded Spill
; CHECK-NEXT:    pshb
; CHECK-NEXT:    psha
; CHECK-NEXT:    tsx
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    subd 0,x
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    inx
; CHECK-NEXT:    inx
; CHECK-NEXT:    txs
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    des
; CHECK-NEXT:    des
; CHECK-NEXT:    des
; CHECK-NEXT:    ldab #5
; CHECK-NEXT:    tsx
; CHECK-NEXT:    stab 2,x
; CHECK-NEXT:    ldx >__m6800_fp
; CHECK-NEXT:    ldd 0,x ; 2-byte Folded Reload
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x
; CHECK-NEXT:    ldx >__m6800_fp
; CHECK-NEXT:    ldd 6,x
; CHECK-NEXT:    jsr f3
; CHECK-NEXT:    ins
; CHECK-NEXT:    ins
; CHECK-NEXT:    ins
; CHECK-NEXT:    lds >__m6800_fp
; CHECK-NEXT:    ins
; CHECK-NEXT:    pulx
; CHECK-NEXT:    stx >__m6800_fp
; CHECK-NEXT:    rts
  %a = alloca i8, i16 %n
  call void @use(ptr %a)
  call void @f3(i16 %x, i16 %n, i8 5)
  ret void
}

