; -O0 code paths. The greedy allocator is used at -O0 too (the fast one
; cannot work with one-register classes), and M6800SplitDOperands copies
; D-only tied operands into fresh registers so chains of D operations do not
; run out of registers. Every value lives in a stack slot between
; statements.


define i16 @add(i16 %a, i16 %b) {
; CHECK-LABEL: add:
; CHECK:       ; %bb.0:
