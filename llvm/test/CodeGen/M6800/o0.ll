; CHECK-NEXT:    ldx 2,x
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    addd 0,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
  %r = add i16 %a, %b
  ret i16 %r
}

