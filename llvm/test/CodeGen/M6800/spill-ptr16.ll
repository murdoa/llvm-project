; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; A pointer (PTR16, which has SP and FP in it) spilled in the loop. The
; spill and reload use ST16m and LD16m, which take GR16, so the register is
; narrowed to X.

define i16 @f(ptr %q) {
; CHECK-LABEL: f:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    ldd #-1
; CHECK-NEXT:    pshb
; CHECK-NEXT:    psha
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 6,x ; 2-byte Folded Spill
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    pula
; CHECK-NEXT:    pulb
; CHECK-NEXT:    pshb
; CHECK-NEXT:    psha
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 8,x ; 2-byte Folded Spill
; CHECK-NEXT:    pula
; CHECK-NEXT:    pulb
; CHECK-NEXT:  .LBB0_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldx 6,x ; 2-byte Folded Reload
; CHECK-NEXT:    inx
; CHECK-NEXT:    inx
; CHECK-NEXT:    pshb
; CHECK-NEXT:    psha
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 8,x ; 2-byte Folded Spill
; CHECK-NEXT:    pula
; CHECK-NEXT:    pulb
; CHECK-NEXT:    addd #1
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 2,x ; 2-byte Folded Spill
; CHECK-NEXT:    ldx 4,x ; 2-byte Folded Reload
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x ; 2-byte Folded Spill
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldd 2,x ; 2-byte Folded Reload
; CHECK-NEXT:    ldx 6,x ; 2-byte Folded Reload
; CHECK-NEXT:    pshb
; CHECK-NEXT:    psha
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 6,x ; 2-byte Folded Spill
; CHECK-NEXT:    pula
; CHECK-NEXT:    pulb
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldx 0,x ; 2-byte Folded Reload
; CHECK-NEXT:    pshb
; CHECK-NEXT:    psha
; CHECK-NEXT:    subd 0,x
; CHECK-NEXT:    pula
; CHECK-NEXT:    pulb
; CHECK-NEXT:    beq .LBB0_1
; CHECK-NEXT:  ; %bb.2: ; %out
entry:
  br label %loop

loop:
  %i = phi i16 [ %inc, %loop ], [ 0, %entry ]
  %inc = add i16 %i, 1
  %p = getelementptr [2 x i8], ptr %q, i16 %i
  %v = load i16, ptr %p, align 1
  %cmp = icmp eq i16 %v, %i
  br i1 %cmp, label %loop, label %out

out:
  unreachable
}
