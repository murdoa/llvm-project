; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; Varargs. va_list is a pointer into the caller's argument area; va_start
; stores the address of the first variadic argument (just above the fixed
; stack arguments), and va_arg reads it and moves it on. Variadic arguments
; are always passed on the stack.

declare void @llvm.va_start.p0(ptr)
declare void @llvm.va_end.p0(ptr)
declare void @llvm.va_copy.p0.p0(ptr, ptr)

; The fixed argument is in D; the first variadic one at 2,x on entry.
define i16 @first_vararg(i16 %n, ...) {
; CHECK-LABEL: first_vararg:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    addd #4
; CHECK-NEXT:    addd #2
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x
; CHECK-NEXT:    ldd 4,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
  %ap = alloca ptr
  call void @llvm.va_start.p0(ptr %ap)
  %v = va_arg ptr %ap, i16
  call void @llvm.va_end.p0(ptr %ap)
  ret i16 %v
}

; Two fixed arguments: the variadic ones start after the stack one.
define i8 @second_vararg(i16 %a, i16 %b, ...) {
; CHECK-LABEL: second_vararg:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    addd #6
; CHECK-NEXT:    addd #3
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x
; CHECK-NEXT:    ldab 8,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
  %ap = alloca ptr
  call void @llvm.va_start.p0(ptr %ap)
  %v1 = va_arg ptr %ap, i16
  %v2 = va_arg ptr %ap, i8
  call void @llvm.va_end.p0(ptr %ap)
  ret i8 %v2
}

define void @copy(i16 %n, ...) {
; CHECK-LABEL: copy:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    addd #6
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x
; CHECK-NEXT:    std 2,x
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    pulx
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
  %ap = alloca ptr
  %aq = alloca ptr
  call void @llvm.va_start.p0(ptr %ap)
  call void @llvm.va_copy.p0.p0(ptr %aq, ptr %ap)
  call void @use(ptr %aq)
  ret void
}

declare void @use(ptr)
declare void @vcallee(i8, ...)

; An i8 first fixed argument is in B; variadic i8, i16 and i32 values go
; on the stack in order.
define void @call_varargs(i32 %x) {
; CHECK-LABEL: call_varargs:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    des
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldx 9,x
; CHECK-NEXT:    pshb
; CHECK-NEXT:    psha
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 7,x
; CHECK-NEXT:    pula
; CHECK-NEXT:    pulb
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 3,x
; CHECK-NEXT:    ldd #3
; CHECK-NEXT:    std 1,x
; CHECK-NEXT:    ldab #2
; CHECK-NEXT:    stab 0,x
; CHECK-NEXT:    ldab #1
; CHECK-NEXT:    jsr vcallee
