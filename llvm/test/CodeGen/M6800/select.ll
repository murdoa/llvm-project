; select and setcc become SELECT* pseudos, which the custom inserter turns
; into a compare-and-branch diamond and a PHI.

define i8 @sel8_eq(i8 %a, i8 %x, i8 %y) {
; CHECK-LABEL: sel8_eq:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    addd #5
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    pshb
; CHECK-NEXT:    psha
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 2,x ; 2-byte Folded Spill
; CHECK-NEXT:    pula
; CHECK-NEXT:    pulb
; CHECK-NEXT:    tsx
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    addd #4
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tstb
; CHECK-NEXT:    beq .LBB0_2
; CHECK-NEXT:  ; %bb.1:
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldx 0,x ; 2-byte Folded Reload
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    ldab 0,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
  %c = icmp eq i8 %a, 0
  %r = select i1 %c, i8 %x, i8 %y
  ret i8 %r
}

