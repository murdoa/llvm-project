; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; A byte in memory compared with zero is "tst mem", which needs no register.

@g = global i8 0

declare void @f()

define void @eq() {
; CHECK-LABEL: eq:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    tst g
; CHECK-NEXT:    beq .LBB0_1
; CHECK-NEXT:  ; %bb.2: ; %e
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_1: ; %t
; CHECK-NEXT:    jsr f
; CHECK-NEXT:    rts
  %v = load i8, ptr @g
  %c = icmp eq i8 %v, 0
  br i1 %c, label %t, label %e
t:
  call void @f()
  ret void
e:
  ret void
}

define void @slt(ptr %p) {
; CHECK-LABEL: slt:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tst 3,x
; CHECK-NEXT:    blt .LBB1_1
; CHECK-NEXT:  ; %bb.2: ; %e
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB1_1: ; %t
; CHECK-NEXT:    jsr f
; CHECK-NEXT:    rts
  %q = getelementptr i8, ptr %p, i16 3
  %v = load i8, ptr %q
  %c = icmp slt i8 %v, 0
  br i1 %c, label %t, label %e
t:
  call void @f()
  ret void
e:
  ret void
}

; In page zero, with A or B free, "ldaa <n" (3 cycles, 2 bytes) does what
; "tst n" (6 cycles, 3 bytes) does for the conditions that do not read C.

