; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; Size-optimized functions are not region split (from the c-torture test
; pr84339). Here p lives in X for the stores and on the stack across the
; call; splitting p put a copy between a constant loaded into D and its
; store, and with X holding the base nothing was left for the copy: "ran
; out of registers".

declare ptr @malloc(i16)
declare i16 @strlen(ptr)
declare void @free(ptr)
declare void @abort()

define i16 @main() minsize {
; CHECK-LABEL: main:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    ldd #19
; CHECK-NEXT:    jsr malloc
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 2,x ; 2-byte Folded Spill
; CHECK-NEXT:    subd #0
; CHECK-NEXT:    beq .LBB0_3
; CHECK-NEXT:  ; %bb.1: ; %fill
; CHECK-NEXT:    ldd #1
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldx 2,x ; 2-byte Folded Reload
; CHECK-NEXT:    std 0,x
; CHECK-NEXT:    inx
; CHECK-NEXT:    inx
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x ; 2-byte Folded Spill
; CHECK-NEXT:    ldd #26368
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldx 2,x ; 2-byte Folded Reload
; CHECK-NEXT:    std 8,x
; CHECK-NEXT:    ldd #25958
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldx 2,x ; 2-byte Folded Reload
; CHECK-NEXT:    std 6,x
; CHECK-NEXT:    ldd #25444
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldx 2,x ; 2-byte Folded Reload
; CHECK-NEXT:    std 4,x
; CHECK-NEXT:    ldd #24930
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldx 2,x ; 2-byte Folded Reload
; CHECK-NEXT:    std 2,x
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldd 0,x ; 2-byte Folded Reload
; CHECK-NEXT:    jsr strlen
; CHECK-NEXT:    subd #7
; CHECK-NEXT:    bne .LBB0_4
; CHECK-NEXT:  ; %bb.2: ; %release
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldd 2,x ; 2-byte Folded Reload
; CHECK-NEXT:    jsr free
; CHECK-NEXT:  .LBB0_3: ; %done
; CHECK-NEXT:    ldd #0
; CHECK-NEXT:    pulx
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_4: ; %fail
; CHECK-NEXT:    jsr abort
entry:
  %p = tail call ptr @malloc(i16 19)
  %null = icmp eq ptr %p, null
  br i1 %null, label %done, label %fill

fill:
  store i16 1, ptr %p, align 1
  %b = getelementptr inbounds nuw i8, ptr %p, i16 2
  store i64 7017280452245743360, ptr %b, align 1
  %n = tail call i16 @strlen(ptr %b)
  %ok = icmp eq i16 %n, 7
  br i1 %ok, label %release, label %fail

fail:
  tail call void @abort()
  unreachable

release:
  tail call void @free(ptr %p)
  br label %done

done:
  ret i16 0
}
