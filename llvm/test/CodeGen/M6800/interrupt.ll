; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; An interrupt handler returns with RTI. The CPU saves A, B, X and CC, and
; no register is callee-saved, so the handler saves none of its own. A
; handler makes no sibling calls: the callee would return with RTS.

@count = global i16 0
declare void @work(i16)

define void @tick() "interrupt" {
; CHECK-LABEL: tick:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldd #1
; CHECK-NEXT:    addd count
; CHECK-NEXT:    std count
; CHECK-NEXT:    rti
  %c = load volatile i16, ptr @count
  %n = add i16 %c, 1
  store volatile i16 %n, ptr @count
  ret void
}

define void @calls() "interrupt" {
; CHECK-LABEL: calls:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldd count
; CHECK-NEXT:    jsr work
; CHECK-NEXT:    rti
  %c = load volatile i16, ptr @count
  call void @work(i16 %c)
  ret void
}

define void @tail() "interrupt" {
; CHECK-LABEL: tail:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldd #1
; CHECK-NEXT:    jsr work
; CHECK-NEXT:    rti
  tail call void @work(i16 1)
  ret void
}

; Every register is free to use.
define void @busy(ptr %p) "interrupt" {
; CHECK-LABEL: busy:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    ldd count
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 2,x ; 2-byte Folded Spill
; CHECK-NEXT:    ldd count
; CHECK-NEXT:    std 0,x ; 2-byte Folded Spill
; CHECK-NEXT:    ldd count
; CHECK-NEXT:    ldx count
; CHECK-NEXT:    stx count
; CHECK-NEXT:    std count
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldd 0,x ; 2-byte Folded Reload
; CHECK-NEXT:    std count
; CHECK-NEXT:    ldd 2,x ; 2-byte Folded Reload
; CHECK-NEXT:    std count
; CHECK-NEXT:    pulx
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rti
  %a = load volatile i16, ptr @count
  %b = load volatile i16, ptr @count
  %c = load volatile i16, ptr @count
  %d = load volatile i16, ptr @count
  store volatile i16 %d, ptr @count
  store volatile i16 %c, ptr @count
  store volatile i16 %b, ptr @count
  store volatile i16 %a, ptr @count
  ret void
}
