; Calls. The first i8/i16 argument goes in B/D and the rest into the
; outgoing area at the bottom of the caller's frame (0,x after tsx), which
; the callee sees at 2,x. Every register is caller-saved, so values live
; across a call are spilled.

declare i16 @f0()
declare i16 @f1(i16)
declare i8 @f8(i8)
declare void @f3(i16, i16, i8)
declare i32 @f32(i32)
declare i32 @f32x2(i32, i32)
declare void @vf(i16, ...)

define i16 @call_no_args() {
; CHECK-LABEL: call_no_args:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    jsr f0
; CHECK-NEXT:    rts
  %r = call i16 @f0()
  ret i16 %r
}

