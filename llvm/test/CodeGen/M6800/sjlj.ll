; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; __builtin_setjmp and __builtin_longjmp. Words 1 and 3 of the buffer hold
; the resume address and __m6800_fp; clang stores the frame address and
; SP + 1 in words 0 and 2.

@buf = global [5 x ptr] zeroinitializer

define i16 @setjmp() {
; CHECK-LABEL: setjmp:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldx #buf
; CHECK-NEXT:    ldd #.LBB0_3
; CHECK-NEXT:    std 2,x
; CHECK-NEXT:    ldd >__m6800_fp
; CHECK-NEXT:    std 6,x
; CHECK-NEXT:  ; %bb.1:
; CHECK-NEXT:    ldd #0
; CHECK-NEXT:    rts
; CHECK-NEXT:  .LBB0_3: ; Block address taken
; CHECK-NEXT:    ldd #1
; CHECK-NEXT:    rts
  %r = call i32 @llvm.eh.sjlj.setjmp(ptr @buf)
  %t = trunc i32 %r to i16
  ret i16 %t
}

define void @longjmp() {
; CHECK-LABEL: longjmp:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ldx #buf
; CHECK-NEXT:    ldd 6,x
; CHECK-NEXT:    std >__m6800_fp
; CHECK-NEXT:    lds 4,x
; CHECK-NEXT:    des
; CHECK-NEXT:    ldx 2,x
; CHECK-NEXT:    jmp 0,x
  call void @llvm.eh.sjlj.longjmp(ptr @buf)
  unreachable
}
