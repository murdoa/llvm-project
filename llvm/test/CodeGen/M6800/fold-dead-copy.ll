; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; The spiller folds a dead copy of a spilled value into a reload, which must
; stay dead.

define i32 @f() {
; CHECK-LABEL: f:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    pshx
; CHECK-NEXT:    ldx #0
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 0,x ; 2-byte Folded Spill
; CHECK-NEXT:    xgdx
; CHECK-NEXT:  .LBB0_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    addd #1
; CHECK-NEXT:    xgdx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldd 2,x ; 2-byte Folded Reload
; CHECK-NEXT:    pulx
; CHECK-NEXT:    adcb #0
; CHECK-NEXT:    adca #0
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    std 2,x ; 2-byte Folded Spill
; CHECK-NEXT:    pulx
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    ldd 2,x ; 2-byte Folded Reload
; CHECK-NEXT:    pulx
; CHECK-NEXT:    subd #0
; CHECK-NEXT:    bcs .LBB0_1
; CHECK-NEXT:  ; %bb.2: ; %done
; CHECK-NEXT:    ldd #0
; CHECK-NEXT:    pshb
; CHECK-NEXT:    psha
; CHECK-NEXT:    pulx
; CHECK-NEXT:    ins
; CHECK-NEXT:    ins
; CHECK-NEXT:    rts
entry:
  br label %loop

loop:
  %i = phi i32 [ %inc, %loop ], [ 0, %entry ]
  %inc = add i32 %i, 1
  %cmp = icmp ult i32 %inc, 0
  br i1 %cmp, label %loop, label %done

done:
  ret i32 0
}
