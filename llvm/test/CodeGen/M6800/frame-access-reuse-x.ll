; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m6800 -verify-machineinstrs < %s | FileCheck %s

; The address of a.addr goes in X for "stx c", and the next access to the
; slot reuses it without another TSX. The store no longer kills X.

@c = external global ptr

define void @f(i16 %a) {
; CHECK-LABEL: f:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pshx
; CHECK-NEXT:    tsx
; CHECK-NEXT:    stx c
; CHECK-NEXT:    std 0,x
; CHECK-NEXT:    pulx
; CHECK-NEXT:    rts
  %a.addr = alloca i16, align 1
  store i16 %a, ptr %a.addr, align 1
  store ptr %a.addr, ptr @c, align 1
  ret void
}
